diff --git a/src/pages/allocation-drawer.css b/src/pages/allocation-drawer.css
new file mode 100644
index 0000000..9f3e4af
--- /dev/null
+++ b/src/pages/allocation-drawer.css
@@ -0,0 +1,78 @@
+@font-face {
+  font-family: 'Expensify Neue';
+  src: url('./hx17-assets/ExpensifyNeue-Regular.woff2') format('woff2');
+  font-weight: 400;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: 'Expensify Neue';
+  src: url('./hx17-assets/ExpensifyNeue-Bold.woff2') format('woff2');
+  font-weight: 700;
+  font-display: swap;
+}
+
+.modal-overlay.allocation-overlay {
+  justify-content: flex-end;
+  background: rgb(216 209 199 / 60%);
+}
+
+.modal-card.allocation-drawer {
+  display: flex;
+  flex-direction: column;
+  width: min(100%, 420px);
+  height: 100%;
+  max-height: 100%;
+  border-radius: 0;
+  overflow: hidden;
+  box-shadow: -1px 0 0 #e6e1da;
+  background: #fcfbf9;
+  color: #002e22;
+  font-family: 'Expensify Neue', sans-serif;
+}
+.allocation-drawer :is(button, input, select) { font-family: inherit; }
+.allocation-drawer .modal-header { flex: none; padding: 16px; border-color: #e6e1da; }
+.allocation-drawer .modal-body { flex: 1; overflow: auto; padding: 16px; }
+.allocation-drawer .btn-outline { color: #002e22; border-color: #d8d1c7; }
+.allocation-drawer .btn-primary { background: #03d47c; color: #002e22; border-radius: 24px; }
+.allocation-drawer .btn-primary:hover { background: #00c271; }
+.allocation-header-caption { font-size: 13px; color: #405650; }
+
+.allocation-row {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 105px;
+  gap: 8px;
+  align-items: center;
+  margin-bottom: 8px;
+  padding: 10px 12px;
+  background: #f8f4f0;
+  border-radius: 8px;
+}
+.allocation-row .allocation-edit {
+  display: block;
+  padding: 0;
+  text-align: left;
+  background: transparent;
+  border: 0;
+}
+.allocation-row small { color: #405650; }
+.allocation-row .form-input { text-align: right; }
+.allocation-row label { display: block; font-size: 12px; color: #405650; }
+.allocation-icon { width: 16px; height: 16px; vertical-align: text-bottom; margin-right: 4px; }
+.allocation-drawer .allocation-add { background: transparent; border: 0; padding-inline: 12px; }
+
+.allocation-actions { flex: none; padding: 12px 16px 16px; border-top: 1px solid #e6e1da; }
+.allocation-actions button { width: 100%; min-height: 44px; justify-content: center; }
+.allocation-reimbursable { display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
+.allocation-reimbursable input {
+  appearance: none; position: relative; flex: none; width: 34px; height: 20px;
+  margin: 0; border: 0; border-radius: 12px; background: #8a9894; cursor: pointer;
+}
+.allocation-reimbursable input::before {
+  content: ''; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px;
+  border-radius: 50%; background: white;
+}
+.allocation-reimbursable input:checked { background: #00a96a; }
+.allocation-reimbursable input:checked::before { transform: translateX(14px); }
+.allocation-reimbursable input:focus-visible { outline: 2px solid #005f46; outline-offset: 2px; }
+.allocation-error { color: #842916; margin-bottom: 8px; }
