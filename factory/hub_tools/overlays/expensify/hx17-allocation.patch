diff --git a/src/pages/AllocationDesk.jsx b/src/pages/AllocationDesk.jsx
new file mode 100644
index 0000000..97dd461
--- /dev/null
+++ b/src/pages/AllocationDesk.jsx
@@ -0,0 +1,81 @@
+import React, {useState} from 'react';
+import {useApp} from '../context/AppContext';
+import plusIcon from './hx17-assets/plus.svg';
+import folderIcon from './hx17-assets/folder.svg';
+import './allocation-drawer.css';
+
+const money = cents => (cents / 100).toFixed(2);
+function initialRows(expense) {
+  if (expense.allocations.length) return expense.allocations.map(row => ({...row, dollars: money(row.amount)}));
+  const half = Math.trunc(expense.amount / 2);
+  return [expense.amount - half, half].map(amount => ({
+    dollars: money(amount), beneficiary: '', reimbursable: expense.reimbursable,
+    category: expense.category, date: expense.date, description: expense.description
+  }));
+}
+
+export default function AllocationDesk({expense, onClose}) {
+  const {state, dispatch} = useApp();
+  const [page, setPage] = useState('Expense');
+  const [more, setMore] = useState(false);
+  const [rows, setRows] = useState(() => initialRows(expense));
+  const [edit, setEdit] = useState(0);
+  const [error, setError] = useState('');
+  const change = (i, values) => setRows(old => old.map((row, j) => j === i ? {...row, ...values} : row));
+  const save = () => {
+    if (rows.some(r => !r.beneficiary || !/^-?\d+(\.\d{1,2})?$/.test(r.dollars))) {
+      setError('Enter an amount and select a workspace tag for every split.'); return;
+    }
+    const allocations = rows.map(({dollars, ...r}) => ({...r, amount: Math.round(Number(dollars)*100)}));
+    if (allocations.some(r => Math.sign(r.amount) !== Math.sign(expense.amount)) ||
+        Math.abs(allocations.reduce((sum, r) => sum+r.amount, 0)) > Math.abs(expense.amount)) {
+      setError('Split amounts must fit within the original expense.'); return;
+    }
+    dispatch({type:'UPDATE_EXPENSE', payload:{id:expense.id, allocations}});
+    onClose();
+  };
+  const row = rows[edit];
+  return <div className="modal-overlay allocation-overlay"><section className="modal-card allocation-drawer" role="dialog" aria-modal="true" aria-labelledby="allocation-title">
+    <header className="modal-header"><div><h2 id="allocation-title">{page}</h2>{page !== 'Expense' && <p className="allocation-header-caption">{money(expense.amount)} USD · {expense.merchant}</p>}</div><button className="btn btn-outline" onClick={onClose}>Close</button></header>
+    <div className="modal-body">
+      {page === 'Expense' && <>
+        <h3>{expense.merchant}</h3><h2>{money(expense.amount)} USD</h2>
+        <p>{expense.date} · {expense.category}</p><p>{expense.description}</p>
+        <p>Receipt · {expense.receiptRef}{expense.reversalOf && ' · Credit for '+expense.reversalOf}</p>
+        {expense.allocations.map((r,i) => <p key={i}>{r.beneficiary} · {money(r.amount)} USD · {r.reimbursable?'Reimbursable':'Non-reimbursable'}</p>)}
+        {!expense.excluded && <button className="btn btn-outline" onClick={() => setMore(!more)}>More</button>}
+        {more && <button className="btn btn-outline" onClick={() => {setMore(false);setPage('Split expense')}}>{expense.allocations.length?'Edit splits':'Split expense'}</button>}
+      </>}
+      {page === 'Split expense' && <>
+        <p>{expense.receiptRef}</p>
+        {rows.map((r,i) => <div key={i} className="allocation-row">
+          <button className="btn btn-outline allocation-edit" onClick={() => {setEdit(i);setPage('Edit split')}}>
+            <small>{r.date}</small><br/>
+            <strong>Split {i+1} · {r.beneficiary || 'Select tag'}</strong><br/>
+            <small><img src={folderIcon} alt="" className="allocation-icon"/>{r.category}</small>
+          </button>
+          <div>
+            <label htmlFor={'amount-'+i}>Amount {i+1}</label>
+            <input id={'amount-'+i} className="form-input" aria-label={'Amount for split '+(i+1)} value={r.dollars} onChange={e => change(i,{dollars:e.target.value})}/>
+          </div>
+        </div>)}
+        <button className="btn btn-outline allocation-add" onClick={() => setRows([...rows,{...rows[0],beneficiary:'',dollars:'0.00',reimbursable:expense.reimbursable}])}>
+          <img src={plusIcon} alt="" className="allocation-icon"/> Add split
+        </button>
+      </>}
+      {page === 'Edit split' && <>
+        <label className="form-group">Tag<select autoFocus className="form-select" value={row.beneficiary} onChange={e => change(edit,{beneficiary:e.target.value})}><option value="">Select tag</option>{state.tags.map(t => <option key={t.id}>{t.name}</option>)}</select></label>
+        <label className="form-group">Category<select className="form-select" value={row.category} onChange={e => change(edit,{category:e.target.value})}>{state.categories.map(c => <option key={c.id}>{c.name}</option>)}</select></label>
+        <label className="form-group">Date<input className="form-input" type="date" value={row.date} onChange={e => change(edit,{date:e.target.value})}/></label>
+        <label className="form-group">Description<input className="form-input" value={row.description} onChange={e => change(edit,{description:e.target.value})}/></label>
+        <label className="allocation-reimbursable">Reimbursable<input type="checkbox" role="switch" checked={row.reimbursable} onChange={e => change(edit,{reimbursable:e.target.checked})}/></label>
+        <footer style={{marginTop:18}}><button className="btn btn-primary" onClick={() => setPage('Split expense')}>Done</button>
+        {rows.length>1 && <button className="btn btn-outline" onClick={() => {setRows(rows.filter((_,i) => i!==edit));setPage('Split expense')}}>Remove split</button>}</footer>
+      </>}
+    </div>
+    {page === 'Split expense' && <footer className="allocation-actions">
+      {error && <p role="alert" className="allocation-error">{error}</p>}
+      <button className="btn btn-primary" onClick={save}>Save</button>
+    </footer>}
+  </section></div>;
+}
