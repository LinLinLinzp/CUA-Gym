+// A poll adds incoming messages without replacing the channel, thread or composer.
+export const mergeLiveMessages = (state, incoming) => {
+  if (!state || !incoming) return state;
+  let messages = state.messages;
+  for (const [channel, arrivals] of Object.entries(incoming)) {
+    const existing = messages[channel] || [];
+    const ids = new Set(existing.map(row => row.messageId));
+    const added = arrivals.filter(row => !ids.has(row.messageId));
+    if (added.length === 0) continue;
+    messages = {
+      ...messages,
+      [channel]: [...existing, ...added].sort((a, b) => Date.parse(a.timestamp) - Date.parse(b.timestamp))
+    };
+  }
+  return messages === state.messages ? state : { ...state, messages };
+};
