diff --git a/src/utils/inventoryBatches.js b/src/utils/inventoryBatches.js
new file mode 100644
--- /dev/null
+++ b/src/utils/inventoryBatches.js
@@ -0,0 +1,111 @@
+const REPORT_COLUMNS = [
+  'seller-sku', 'asin1', 'item-name', 'price', 'minimum-seller-allowed-price',
+  'maximum-seller-allowed-price', 'quantity', 'fulfillment-channel', 'status'
+];
+
+export const UPDATE_COLUMNS = ['sku','size_name','color_name','material_type','compliance_certificate'];
+
+export const REPORT_TYPES = {
+  all_listings: 'All Listings Report',
+  active_listings: 'Active Listings Report'
+};
+
+function money(value) {
+  return Number.isFinite(value) ? value.toFixed(2) : '';
+}
+
+function field(value) {
+  return String(value ?? '').replace(/[\t\r\n]+/g, ' ');
+}
+
+export function tsv(rows) {
+  return rows.map(row => row.map(field).join('\t')).join('\n') + '\n';
+}
+
+function nextId(prefix, previous) {
+  const used = new Set(previous.map(entry => entry.id));
+  let index = previous.length + 1;
+  let id = prefix + String(index).padStart(3, '0');
+  while (used.has(id)) {
+    index += 1;
+    id = prefix + String(index).padStart(3, '0');
+  }
+  return id;
+}
+
+export function requestReport(products, previous, reportType, at) {
+  const snapshot = products.filter(product => reportType === 'all_listings' || product.status === 'Active');
+  const rows = snapshot.map(product => [
+    product.sku, product.asin, product.title, money(product.price),
+    money(product.minimumSellerAllowedPrice), money(product.maximumSellerAllowedPrice),
+    product.availableQuantity, product.fulfillmentChannel === 'FBA' ? 'AMAZON_NA' : 'DEFAULT',
+    product.status
+  ]);
+  const title = REPORT_TYPES[reportType];
+  return {
+    id: nextId('RPT_', previous), reportType, reportName: title,
+    requestedAt: at, completedAt: at, downloadedAt: null, status: 'Ready',
+    fileName: title.replaceAll(' ', '') + '_' + at.slice(0, 10) + '.txt',
+    rowCount: rows.length, content: tsv([REPORT_COLUMNS, ...rows])
+  };
+}
+
+function parseUpdate(parts, products, seen) {
+  const [sku, priceText, minText, maxText, quantityText, channel] = parts;
+  if (parts.length !== UPDATE_COLUMNS.length) return { message: 'Expected six tab-delimited fields.' };
+  const stored = products.get(sku);
+  if (!stored) return { message: 'Seller SKU does not match an existing offer.' };
+  if (seen.has(sku)) return { message: 'Seller SKU is repeated in this file.' };
+  seen.add(sku);
+  const moneyValues = [priceText, minText, maxText];
+  if (!moneyValues.every(text => /^\d+\.\d{2}$/.test(text) && Number.isFinite(Number(text)))) {
+    return { message: 'Each price must be a dollar amount with two decimal places.' };
+  }
+  const [price, minimumSellerAllowedPrice, maximumSellerAllowedPrice] = moneyValues.map(Number);
+  if (minimumSellerAllowedPrice < 0 || price <= 0 || maximumSellerAllowedPrice < minimumSellerAllowedPrice ||
+      price < minimumSellerAllowedPrice || price > maximumSellerAllowedPrice) {
+    return { message: 'The selling price is outside the supplied pricing limits.' };
+  }
+  const fba = stored.fulfillmentChannel === 'FBA';
+  if (channel !== (fba ? 'AMAZON_NA' : 'DEFAULT')) return { message: 'Fulfillment channel differs from the existing offer.' };
+  if (fba ? quantityText !== '' : !/^\d+$/.test(quantityText) || !Number.isSafeInteger(Number(quantityText))) {
+    return { message: fba ? 'FBA quantities must be left blank.' : 'Quantity must be a nonnegative integer.' };
+  }
+  return {
+    price, minimumSellerAllowedPrice, maximumSellerAllowedPrice,
+    availableQuantity: fba ? stored.availableQuantity : Number(quantityText)
+  };
+}
+
+export function applyPriceQuantity(products, previous, uploaded, text, uploadedAt) {
+  const lines=text.replace(/^\uFEFF/,'').split(/\r?\n/).filter(line=>line.length>0), header=['sku','size_name','color_name','material_type','compliance_certificate'];
+  const rows=lines.slice(1),errors=[],rowResults=[],changed=new Map(),seen=new Set();
+  if(lines[0]!==header.join('\t')) errors.push({row:1,sku:'',message:'Use the Product specifications template.'});
+  else rows.forEach((line,index)=>{
+    const parts=line.split('\t'),sku=parts[0],p=products.find(p=>p.sku===sku);let message='';
+    if(parts.length!==5 || !p) message='Unknown SKU or invalid column count';
+    else if(seen.has(sku)) message='Duplicate SKU in submission';
+    else if(!parts[1]||!parts[2]||!parts[3]) message='Required size_name, color_name and material_type missing';
+    else if(parts[1]!==p.catalogValidation.size_name) message='8541: size_name conflicts with manufacturer variant';
+    else if(!['Stoneware','Borosilicate glass','Cotton'].includes(parts[3])) message='90244: material_type is not a supported enumeration';
+    else if(p.catalogValidation.certificateRequired&&!p.catalogValidation.approvedCertificates.includes(parts[4])) message=p.catalogValidation.certificateIssue;
+    else if(!p.catalogValidation.certificateRequired&&parts[4]) message='8570: certificate does not apply to this variant';
+    seen.add(sku);
+    if(message) errors.push({row:index+2,sku,message});
+    else changed.set(sku,Object.fromEntries(header.slice(1).map((key,i)=>[key,parts[i+1]])));
+    rowResults.push({row:index+2,sku,status:message?'Rejected':'Accepted',message});
+  });
+  const record={id:nextId('UPL_',previous),fileType:'catalog_specs',fileName:uploaded.original_name,storedName:uploaded.stored_name,url:uploaded.url,size:uploaded.size,contentType:uploaded.content_type,uploadedAt,recordsProcessed:rows.length,recordsSuccessful:changed.size,errors,rowResults,status:errors.length?(changed.size?'Done with errors':'Failed'):'Done'};
+  return {record,products:products.map(p=>changed.has(p.sku)?{...p,...changed.get(p.sku),lastUpdated:uploadedAt}:p)};
+}
+
+export function saveTextFile(name, content) {
+  const url = URL.createObjectURL(new Blob([content], { type: 'text/tab-separated-values' }));
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = name;
+  document.body.append(link);
+  link.click();
+  link.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 4000);
+}
