diff --git a/src/pages/InventoryReports.jsx b/src/pages/InventoryReports.jsx
new file mode 100644
--- /dev/null
+++ b/src/pages/InventoryReports.jsx
@@ -0,0 +1,96 @@
+import React, { useState } from 'react';
+import { Link } from 'react-router-dom';
+import { Download, FileSpreadsheet } from 'lucide-react';
+import { useApp } from '../context/AppContext';
+import { REPORT_TYPES, saveTextFile } from '../utils/inventoryBatches';
+
+const date = value => value ? new Date(value).toLocaleString() : '—';
+
+export default function InventoryReports() {
+  const { state, dispatch } = useApp();
+  const [requestType, setRequestType] = useState('active_listings');
+  const [filterType, setFilterType] = useState('all');
+  const [search, setSearch] = useState('');
+  if (!state) return null;
+
+  const reports = [...(state.inventoryReports || [])].reverse().filter(report => {
+    const query = search.trim().toLowerCase();
+    const matchesQuery = [report.id, report.fileName].some(value => value?.toLowerCase().includes(query));
+    return matchesQuery && (filterType === 'all' || filterType === report.reportType);
+  });
+
+  function request() {
+    dispatch({ type: 'REQUEST_INVENTORY_REPORT', payload: { reportType: requestType, at: new Date().toISOString() } });
+    setFilterType('all');
+    setSearch('');
+  }
+
+  function download(report) {
+    if (!report.content) return;
+    saveTextFile(report.fileName, report.content);
+    dispatch({ type: 'DOWNLOAD_INVENTORY_REPORT', payload: { id: report.id, at: new Date().toISOString() } });
+  }
+
+  return (
+    <main>
+      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'start', marginBottom: 15 }}>
+        <div>
+          <Link to="/inventory">Manage All Inventory</Link>
+          <h1 style={{ fontSize: 28, lineHeight: '36px', margin: '4px 0' }}>Inventory Reports</h1>
+        </div>
+        <Link to="/inventory/upload" className="btn-secondary">Add Products via Upload</Link>
+      </div>
+      <section className="card">
+        <h2 className="card-title">Request an inventory report</h2>
+        <div style={{ display: 'flex', gap: 14, alignItems: 'end' }}>
+          <label>
+            <strong>Report type</strong><br />
+            <select className="form-select" value={requestType} onChange={event => setRequestType(event.target.value)}>
+              {Object.entries(REPORT_TYPES).map(([key, label]) => <option key={key} value={key}>{label}</option>)}
+            </select>
+          </label>
+          <button className="btn-primary" onClick={request}><FileSpreadsheet size={15} /> Request Report</button>
+        </div>
+        <p style={{ marginBottom: 0, color: 'var(--muted)' }}>
+          {requestType === 'all_listings'
+            ? 'Includes active, inactive, suppressed, and zero-quantity listings.'
+            : 'Includes active listings only. For inactive offers, request an All Listings Report.'}
+        </p>
+      </section>
+
+      <section className="card">
+        <h2 className="card-title">Check Report Status &amp; Download</h2>
+        <div style={{ display: 'flex', gap: 8, alignItems: 'center', marginBottom: 12 }}>
+          <input className="form-input" aria-label="Search reports" placeholder="Search by report ID or filename"
+            value={search} onChange={event => setSearch(event.target.value)} style={{ width: 255 }} />
+          <select className="form-select" aria-label="Filter report type" value={filterType}
+            onChange={event => setFilterType(event.target.value)}>
+            <option value="all">All report types</option>
+            {Object.entries(REPORT_TYPES).map(([key, label]) => <option key={key} value={key}>{label}</option>)}
+          </select>
+        </div>
+        <div style={{ overflowX: 'auto' }}>
+          <table className="data-table">
+            <thead><tr><th>Report ID</th><th>Report type</th><th>Requested</th><th>Status</th><th>Listings</th><th>Action</th></tr></thead>
+            <tbody>
+              {reports.map(report => (
+                <tr key={report.id}>
+                  <td>{report.id}</td><td>{report.reportName}</td><td>{date(report.requestedAt)}</td>
+                  <td><span className="badge badge-success">{report.status}</span></td><td>{report.rowCount}</td>
+                  <td>
+                    {report.content ? (
+                      <button className="btn-secondary" onClick={() => download(report)}>
+                        <Download size={14} /> Download
+                      </button>
+                    ) : 'File expired'}
+                  </td>
+                </tr>
+              ))}
+              {!reports.length && <tr><td colSpan={6}>No reports match the selected filters.</td></tr>}
+            </tbody>
+          </table>
+        </div>
+      </section>
+    </main>
+  );
+}
