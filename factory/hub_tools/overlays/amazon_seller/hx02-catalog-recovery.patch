new file mode 100644
--- /dev/null
+++ b/src/pages/InventoryUploads.jsx
@@ -0,0 +1,155 @@
+import React, { useRef, useState } from 'react';
+import { Link } from 'react-router-dom';
+import { FileText, Upload } from 'lucide-react';
+import { useApp } from '../context/AppContext';
+import { getSessionId } from '../utils/dataManager';
+import { saveTextFile, tsv, UPDATE_COLUMNS } from '../utils/inventoryBatches';
+
+const date = value => value ? new Date(value).toLocaleString() : '—';
+const statusClass = { Done: 'success', 'Done with errors': 'pending', Failed: 'error' };
+
+function downloadResult(record) {
+  const rows = [
+    ['Batch ID', record.id],
+    ['Processed', record.recordsProcessed, 'Successful', record.recordsSuccessful],
+    ['Row', 'SKU', 'Status', 'Issue'],
+    ...(record.rowResults || record.errors || []).map(error => [error.row, error.sku, error.status || 'Rejected', error.message])
+  ];
+  saveTextFile(record.id + '_processing_report.txt', tsv(rows));
+}
+
+export default function InventoryUploads() {
+  const { state, dispatch } = useApp();
+  const input = useRef(null);
+  const inFlight = useRef(false);
+  const [panel, setPanel] = useState('upload');
+  const [file, setFile] = useState(null);
+  const [kind, setKind] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [query, setQuery] = useState('');
+  const [status, setStatus] = useState('all');
+  if (!state) return null;
+
+  const batches = [...(state.inventoryFileUploads || [])].reverse().filter(batch => (
+    (status === 'all' || batch.status === status) &&
+    [batch.id, batch.fileName].some(value => value?.toLowerCase().includes(query.trim().toLowerCase()))
+  ));
+
+  async function submit(event) {
+    event.preventDefault();
+    const sid = getSessionId();
+    if (!file || kind !== 'price_quantity' || inFlight.current) return;
+    if (file.size > 1_000_000 || !/\.(txt|tsv)$/i.test(file.name)) {
+      setError('Choose a tab-delimited .txt or .tsv file under 1 MB.');
+      return;
+    }
+    inFlight.current = true;
+    setBusy(true);
+    setError('');
+    try {
+      const text = await file.text();
+      const form = new FormData();
+      form.append('files', file);
+      const url = sid ? '/upload?sid=' + encodeURIComponent(sid) : '/upload';
+      const response = await fetch(url, { method: 'POST', body: form });
+      if (!response.ok) throw new Error('Upload request failed');
+      const { files } = await response.json();
+      if (!files?.[0]?.url) throw new Error('Upload receipt is missing');
+      dispatch({ type: 'UPLOAD_PRICE_QUANTITY', payload: { uploaded: files[0], text, at: new Date().toISOString() } });
+      setFile(null);
+      if (input.current) input.current.value = '';
+      setStatus('all');
+      setQuery('');
+      setPanel('status');
+    } catch {
+      setError('We could not store this upload. Check your file and try again.');
+    } finally {
+      setBusy(false);
+      inFlight.current = false;
+    }
+  }
+
+  return (
+    <main>
+      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'start', marginBottom: 15 }}>
+        <div>
+          <Link to="/inventory">Manage All Inventory</Link>
+          <h1 style={{ fontSize: 28, lineHeight: '36px', margin: '4px 0' }}>Add Products via Upload</h1>
+        </div>
+        <Link to="/reports/inventory" className="btn-secondary">Inventory Reports</Link>
+      </div>
+      <nav aria-label="Inventory upload" style={{ display: 'flex', gap: 6, borderBottom: '1px solid var(--divider)', marginBottom: 14 }}>
+        {Object.entries({ upload: 'Upload your inventory file', status: 'Check Upload Status' }).map(([key, label]) => (
+          <button key={key} className="btn-secondary" aria-current={panel === key ? 'page' : undefined}
+            onClick={() => setPanel(key)} style={{ height: 38, borderBottom: panel === key ? '3px solid var(--info)' : undefined }}>
+            {label}
+          </button>
+        ))}
+      </nav>
+
+      {panel === 'upload' ? (
+        <div style={{ display: 'grid', gridTemplateColumns: 'minmax(360px, 2fr) minmax(230px, 1fr)', gap: 14 }}>
+          <section className="card">
+            <h2 className="card-title">Submit an inventory file</h2>
+            <form onSubmit={submit} style={{ display: 'grid', gap: 14, justifyItems: 'start' }}>
+              <div><strong>Marketplace</strong><br />{state.seller?.marketplace || 'United States'}</div>
+              <label><strong>File type</strong><br />
+                <select className="form-select" value={kind} onChange={event => setKind(event.target.value)}>
+                  <option value="">Select a file type</option>
+                  <option value="price_quantity">Product specifications</option>
+                </select>
+              </label>
+              <label><strong>Inventory file</strong><br />
+                <input type="file" ref={input} accept=".txt,.tsv" onChange={event => setFile(event.target.files[0] || null)} />
+              </label>
+              {error && <div role="alert" className="badge badge-error">{error}</div>}
+              <button className="btn-primary" disabled={!file || !kind || busy}>
+                <Upload size={15} /> {busy ? 'Uploading…' : 'Upload'}
+              </button>
+            </form>
+          </section>
+          <aside className="card" style={{ alignSelf: 'start' }}>
+            <h2 className="card-title">Update existing offers</h2>
+            <p>Update size, color and material for existing variants. Certificate requirements are checked per item.</p>
+            <button className="btn-secondary"
+              onClick={() => saveTextFile('ProductSpecificationsTemplate.txt', tsv([UPDATE_COLUMNS]))}>
+              <FileText size={15} /> Download template
+            </button>
+          </aside>
+        </div>
+      ) : (
+        <section className="card">
+          <h2 className="card-title">Monitor upload status</h2>
+          <div style={{ display: 'flex', gap: 8, marginBottom: 12 }}>
+            <input aria-label="Search inventory uploads" className="form-input" value={query}
+              placeholder="Search by batch ID or filename" style={{ width: 255 }}
+              onChange={event => setQuery(event.target.value)} />
+            <select aria-label="Upload status" className="form-select" value={status} onChange={event => setStatus(event.target.value)}>
+              <option value="all">All statuses</option>
+              {Object.keys(statusClass).map(label => <option key={label} value={label}>{label}</option>)}
+            </select>
+          </div>
+          <div style={{ overflowX: 'auto' }}>
+            <table className="data-table">
+              <thead><tr><th>Date submitted</th><th>Batch ID</th><th>File name</th><th>File type</th><th>Status</th><th>Results</th><th>Actions</th></tr></thead>
+              <tbody>
+                {batches.map(batch => (
+                  <tr key={batch.id}>
+                    <td>{date(batch.uploadedAt)}</td><td>{batch.id}</td>
+                    <td>{batch.url ? <a href={batch.url} download>{batch.fileName}</a> : batch.fileName}</td>
+                    <td>Product specifications</td>
+                    <td><span className={'badge badge-' + (statusClass[batch.status] || 'info')}>{batch.status}</span></td>
+                    <td>{batch.recordsSuccessful} of {batch.recordsProcessed} successful</td>
+                    <td><button type="button" className="btn-link" onClick={() => downloadResult(batch)}>Download Processing Report</button></td>
+                  </tr>
+                ))}
+                {!batches.length && <tr><td colSpan={7}>No uploads match the selected filters.</td></tr>}
+              </tbody>
+            </table>
+          </div>
+        </section>
+      )}
+    </main>
+  );
+}
