+.hx04-detail-backdrop { position:fixed; inset:0; z-index:100; background:#0005; display:grid; place-items:center; }
+.hx04-detail { width:740px; max-width:95vw; max-height:90vh; overflow:auto; background:#f8f7f6; color:#222; border:1px solid #8f9598; box-shadow:0 4px 20px #0005; text-align:left; }
+.hx04-detail header { position:static; display:block; padding:10px 12px; background:#465864; font-size:16px; font-weight:bold; color:#fff; }
+.hx04-detail button { border:1px solid #a2a4a5; border-radius:3px; padding:6px 14px; background:#fafafa; color:#20272b; cursor:pointer; }
+.hx04-detail button.primary { background:#316477; color:white; border-color:#316477; }
+.hx04-detail button:disabled { opacity:.45; cursor:default; }
+.hx04-detail-actions { display:flex; gap:12px; padding:10px 12px; }
+.hx04-detail-summary { display:grid; grid-template-columns:minmax(0,3fr) minmax(75px,1fr); gap:8px 12px; padding:14px 12px 22px; }
+.hx04-detail-summary small { display:block; font-size:12px; color:#465864; }
+.hx04-detail-grid { margin:8px 12px; border:1px solid #c4cbce; background:white; overflow-x:auto; }
+.hx04-detail-grid h3 { margin:0; padding:7px 10px; font-size:14px; background:#eeece9; border-bottom:1px solid #c4cbce; }
+.hx04-detail-grid table { width:100%; border-collapse:collapse; }
+.hx04-detail-grid th, .hx04-detail-grid td { text-align:left; padding:5px 8px; border-bottom:1px solid #d1d4d6; }
+.hx04-detail-grid th { color:#24343c; background:#fbfaf9; border-bottom:1px solid #48839a; }
+.hx04-detail-grid th:first-child { width:115px; }
+.hx04-detail-grid th b, .hx04-detail-error { color:#a32626; }
+.hx04-detail-grid :is(input,select) { width:100%; box-sizing:border-box; min-height:28px; }
+.hx04-entry,.hx04-selected { background:#f0f7fa; }
+.hx04-detail button.hx04-row-link { background:none; color:#236182; border:none; padding:0; text-decoration:underline; }
+.hx04-row-actions { display:flex; flex-wrap:wrap; gap:8px; padding:8px; border:1px solid #77a1b1; background:#f0f7fa; }
+.hx04-detail-total,.hx04-detail-error { margin:7px 12px; }
