@@ -0,0 +1,161 @@
+import { useState } from 'react'
+import { useWorkspace } from '../context/Workspace.jsx'
+import './InventoryDetail.css'
+
+export default function InventoryDetail({ itemId, locationId, quantity, assignments = [], receipt = false, onChange }) {
+  const { state } = useWorkspace()
+  const [open, setOpen] = useState(false)
+  const [rows, setRows] = useState([])
+  const [position, setPosition] = useState(null)
+  const [editing, setEditing] = useState(false)
+  const [lot, setLot] = useState('')
+  const [qty, setQty] = useState('')
+  const [error, setError] = useState('')
+  const item = state.items.find(x => x.id === itemId)
+  if (!item?.lotNumbered) return null
+
+  const available = (state.inventoryLots || []).filter(x =>
+    x.itemId === itemId && x.locationId === locationId && x.onHand > 0)
+  const selected = available.find(x => x.inventoryNumberId === lot)
+  const total = rows.reduce((sum, row) => sum + row.quantity, 0)
+  const balance = selected && selected.onHand - rows
+    .filter((row, i) => (!editing || i !== position) && row.inventoryNumberId === lot)
+    .reduce((sum, row) => sum + row.quantity, 0)
+  const numberLabel = receipt ? 'Receipt Inventory Number' : 'Issue Inventory Number'
+
+  function clear() {
+    setPosition(null)
+    setEditing(false)
+    setLot('')
+    setQty('')
+    setError('')
+  }
+
+  function start() {
+    clear()
+    setRows(assignments)
+    setQty(String(Number(quantity) - assignments.reduce((sum, row) => sum + row.quantity, 0) || ''))
+    setOpen(true)
+  }
+
+  function selectRow(row, index) {
+    setPosition(index)
+    setEditing(true)
+    setLot(receipt ? row.lotNumber : row.inventoryNumberId)
+    setQty(String(row.quantity))
+    setError('')
+  }
+
+  function add() {
+    const n = Number(qty)
+    const draftLot = lot.trim()
+    const remaining = Number(quantity) - total + (editing ? rows[position].quantity : 0)
+    if (!Number.isFinite(n) || n <= 0 || n > remaining) {
+      setError('Enter an assignment quantity within the remaining line quantity.')
+      return
+    }
+    if (receipt && !draftLot) {
+      setError('Enter the supplier lot number.')
+      return
+    }
+    if (receipt && rows.some((row, i) => (!editing || i !== position) && row.lotNumber === draftLot)) {
+      setError('Increase the quantity on the existing row for this lot number.')
+      return
+    }
+    if (!receipt && (!selected || selected.qualityStatus !== 'Released' || n > balance)) {
+      setError(!selected ? 'Select an inventory number at the source location.' :
+        selected.qualityStatus !== 'Released' ? 'This lot is quarantined and cannot be issued.' :
+        'Assignment exceeds the available quantity for this lot.')
+      return
+    }
+    const row = receipt ? { lotNumber: draftLot, quantity: n } :
+      { inventoryNumberId: selected.inventoryNumberId, lotNumber: selected.lotNumber, quantity: n }
+    const index = position ?? rows.length
+    const next = [...rows]
+    next.splice(index, editing ? 1 : 0, row)
+    setRows(next)
+    clear()
+    setQty(String(remaining - n || ''))
+  }
+
+  function insert() {
+    setEditing(false)
+    setLot('')
+    setQty(String(Number(quantity) - total || ''))
+    setError('')
+  }
+
+  function remove() {
+    setRows(rows.filter((_, index) => index !== position))
+    const remaining = Number(quantity) - total + rows[position].quantity
+    clear()
+    setQty(String(remaining || ''))
+  }
+
+  function accept() {
+    if (!rows.length || total !== Number(quantity) || lot || editing) {
+      setError('Add the assignments and match the transaction line quantity before selecting OK.')
+      return
+    }
+    onChange(rows)
+    setOpen(false)
+  }
+
+  const actions = () => <div className="hx04-detail-actions">
+    <button type="button" className="primary" onClick={accept}>OK</button>
+    <button type="button" onClick={() => setOpen(false)}>Close</button>
+  </div>
+
+  return <>
+    <button type="button" onClick={start}>Inventory Detail {assignments.length ? '✓' : ''}</button>
+    {open && <div className="hx04-detail-backdrop">
+      <div role="dialog" aria-modal="true" aria-label="Inventory Detail" className="hx04-detail">
+        <header>Inventory Detail</header>
+        {actions()}
+        <div className="hx04-detail-summary">
+          <div><small>Item</small>{item.itemId}</div>
+          <div><small>Quantity</small>{quantity}</div>
+          <div><small>Description</small>{item.displayName || item.description || item.itemId}</div>
+          <div><small>Units</small>{item.units || 'Ea'}</div>
+        </div>
+        <div className="hx04-detail-grid">
+          <h3>Inventory Assignment</h3>
+          <table>
+            <thead><tr><th>Quantity <b>*</b></th><th>{numberLabel} <b>*</b></th>
+              {!receipt && <><th>Available</th><th>Inspection Disposition</th></>}
+            </tr></thead>
+            <tbody>
+              {rows.map((row, i) => <tr key={i} className={editing && position === i ? 'hx04-selected' : ''}>
+                <td>{row.quantity}</td>
+                <td><button type="button" className="hx04-row-link" onClick={() => selectRow(row, i)}>{row.lotNumber}</button></td>
+                {!receipt && <><td>{available.find(x => x.inventoryNumberId === row.inventoryNumberId)?.onHand}</td><td>Released</td></>}
+              </tr>)}
+              <tr className="hx04-entry">
+                <td><input aria-label="Assignment Quantity" type="number" min="0" step="any" value={qty} onChange={e => setQty(e.target.value)}/></td>
+                <td>{receipt ?
+                  <input aria-label={numberLabel} value={lot} onChange={e => setLot(e.target.value)}/> :
+                  <select aria-label={numberLabel} value={lot} onChange={e => setLot(e.target.value)}>
+                    <option value="">Select an inventory number</option>
+                    {available.map(x => <option key={x.inventoryNumberId} value={x.inventoryNumberId}>
+                      {x.lotNumber} · {x.onHand} available · {x.qualityStatus}
+                    </option>)}
+                  </select>}
+                </td>
+                {!receipt && <><td>{balance ?? ''}</td><td title={selected?.sourceReceiptNumber}>{selected?.qualityStatus}</td></>}
+              </tr>
+            </tbody>
+          </table>
+          <div className="hx04-row-actions">
+            <button type="button" className="primary" onClick={add}>{editing ? 'Update' : 'Add'}</button>
+            <button type="button" onClick={clear}>Cancel</button>
+            <button type="button" disabled={!editing} onClick={insert}>Insert</button>
+            <button type="button" disabled={!editing} onClick={remove}>Remove</button>
+          </div>
+          <p className="hx04-detail-total">Total Assigned <strong>{total}</strong> &nbsp; Remaining <strong>{Number(quantity) - total}</strong></p>
+        </div>
+        {error && <p className="hx04-detail-error" role="alert">{error}</p>}
+        {actions()}
+      </div>
+    </div>}
+  </>
+}
