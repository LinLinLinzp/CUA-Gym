+const boardVisitKey = boardId => `trello_recent_${getSessionId() || 'default'}_${boardId}`;
+
+export function rememberBoardVisit(boardId) {
+  sessionStorage.setItem(boardVisitKey(boardId), new Date().toISOString());
+}
+
+export function withRecentVisit(board) {
+  if (!board) return board;
+  const lastVisitedAt = sessionStorage.getItem(boardVisitKey(board.id));
+  return lastVisitedAt ? { ...board, lastVisitedAt } : board;
+}
+
