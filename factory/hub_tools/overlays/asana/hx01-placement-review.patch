+import { List } from 'lucide-react';
+
+export default function ProjectIcon({ icon, size }: { icon: string; size: number }) {
+  if (icon === 'project') {
+    return <List size={size} color="#fff" aria-hidden="true" />;
+  }
+
+  return <img src={icon} alt="" />;
+}
