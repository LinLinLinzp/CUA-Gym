+    if (loading) return;
+    let stopped = false;
+    const poll = async () => {
+      const incoming = await fetchCustomState(sidRef.current);
+      if (stopped || !incoming) return;
+      setState(previous => {
+        const known = new Set(previous.comments.map(x => x.commentId));
+        const added = (incoming.comments || []).filter(x => x.commentId.startsWith('hx01-') && !known.has(x.commentId));
+        if (!added.length) return previous;
+        const attachments = [...previous.attachments];
+        const aids = new Set(attachments.map(x => x.attachmentId));
+        for (const row of incoming.attachments || []) if (row.attachmentId.startsWith('hx01-') && !aids.has(row.attachmentId)) attachments.push(row);
+        const tasks = previous.tasks.map(task => {
+          const server = (incoming.tasks || []).find(x => x.taskId === task.taskId);
+          if (!server) return task;
+          const extra = (server.attachmentIds || []).filter(x => x.startsWith('hx01-'));
+          return extra.length ? {...task, attachmentIds: [...new Set([...task.attachmentIds, ...extra])]} : task;
+        });
+        return {...previous, comments: [...previous.comments, ...added], attachments, tasks};
+      });
+    };
+    const timer = setInterval(poll, 1200);
+    return () => { stopped = true; clearInterval(timer); };
+  }, [loading]);
