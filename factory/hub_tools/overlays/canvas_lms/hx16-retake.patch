+import React, {useEffect, useState} from 'react';
+import {Link, NavLink, Navigate, useLocation, useNavigate} from 'react-router-dom';
+import {ClipboardList, CheckCircle2, ChevronDown, FileText, GripVertical, Lock, Menu, MoreVertical, Plus, X} from 'lucide-react';
+import GlobalNav from './components/GlobalNav';
+import {useAppContext} from './context/AppContext';
+import './pages/course/Modules.css';
+import './RetakeCourse.css';
+
+const course = '/courses/61';
+const modules = course + '/modules';
+const progress = modules + '/progressions';
+const announcements = course + '/announcements';
+const retake = course + '/pages/retake-instructions';
+const practice = course + '/assignments/6111';
+const people = '/accounts/1/users';
+const label = 'Retake eligibility';
+
+function Settings({policy, dismiss, save}) {
+  const [minimum, setMinimum] = useState(policy.minimum);
+  const [mode, setMode] = useState(policy.requirementMode);
+  const [criterion, setCriterion] = useState(policy.practiceCriterion || null);
+  const [tab, setTab] = useState('settings');
+  useEffect(() => {
+    const close = event => {if (event.key === 'Escape') dismiss();};
+    document.addEventListener('keydown', close);
+    return () => document.removeEventListener('keydown', close);
+  }, [dismiss]);
+
+  return <div className="hx-backdrop">
+    <form className="hx-dialog" role="dialog" aria-modal="true" aria-label="Edit Module Settings"
+      onSubmit={e => {e.preventDefault(); save({minimum: Number(minimum), requirementMode: mode, practiceCriterion: criterion});}}>
+      <header><h2>Edit Module Settings</h2><button type="button" aria-label="Close" onClick={dismiss}><X size={21}/></button></header>
+      <div className="hx-tabs" role="tablist" aria-label="Module settings">
+        <button type="button" role="tab" id="hx-settings-tab" aria-controls="hx-settings-panel" aria-selected={tab === 'settings'} onClick={() => setTab('settings')}>Settings</button>
+        <button type="button" role="tab" id="hx-assign-tab" aria-controls="hx-assign-panel" aria-selected={tab === 'assign'} onClick={() => setTab('assign')}>Assign To</button>
+      </div>
+      <div className="hx-dialog-body" role="tabpanel" id="hx-settings-panel" aria-labelledby="hx-settings-tab" hidden={tab !== 'settings'}>
+        <label className="hx-field">Module Name<input value={label} readOnly/></label>
+        <section className="hx-settings-section"><h3>Prerequisites</h3><p>No prerequisites</p></section>
+        <section className="hx-settings-section">
+          <h3>Requirements</h3>
+          <label className="hx-radio"><input type="radio" name="mode" checked={mode === 'all'} onChange={() => setMode('all')}/>
+            <span>Complete all<small>Students must complete all of these requirements.</small></span>
+          </label>
+          <label className="hx-radio"><input type="radio" name="mode" checked={mode === 'one'} onChange={() => setMode('one')}/>
+            <span>Complete one<small>Students must complete one of these requirements.</small></span>
+          </label>
+          <div className="hx-rule">
+            <label className="hx-field">Content<select defaultValue="diagnostic"><option value="diagnostic">Diagnostic</option></select></label>
+            <select aria-label="Diagnostic requirement" defaultValue="minimum"><option value="minimum">Score at least</option></select>
+            <input type="number" aria-label="Points" min="0" max="100" required value={minimum} onChange={e => setMinimum(e.target.value)}/>
+          </div>
+          {criterion && <div className="hx-rule">
+            <div className="hx-rule-heading"><label htmlFor="practice-content">Content</label>
+              <button type="button" aria-label="Remove requirement" onClick={() => setCriterion(null)}><X size={19}/></button>
+            </div>
+            <select id="practice-content" defaultValue="practice"><option value="practice">Practice workbook</option></select>
+            <select aria-label="Practice workbook requirement" value={criterion} onChange={e => setCriterion(e.target.value)}><option value="view">View the item</option><option value="submit">Submit the assignment</option></select>
+          </div>}
+          {!criterion && <button className="hx-button" type="button" onClick={() => setCriterion('view')}><Plus size={17}/> Requirement</button>}
+        </section>
+      </div>
+      <div className="hx-dialog-body" role="tabpanel" id="hx-assign-panel" aria-labelledby="hx-assign-tab" hidden={tab !== 'assign'}>
+        <section className="hx-assigned"><h3>Assign To</h3><p>Everyone</p></section>
+      </div>
+      <footer><button className="hx-button" type="button" onClick={dismiss}>Cancel</button><button className="hx-primary" type="submit">Save</button></footer>
+    </form>
+  </div>;
+}
+
+
+function EligibilityChange({dismiss, confirm}) {
+  return <div className="hx-backdrop hx-confirm-layer">
+    <section className="hx-relock" role="dialog" aria-modal="true" aria-labelledby="hx-relock-title">
+      <header><h2 id="hx-relock-title">Requirements Changed</h2>
+        <button aria-label="Close" onClick={dismiss}><X size={19}/></button>
+      </header>
+      <div>
+        <p>You have changed the progression requirements for an active course. There may be students who have already progressed to this module and to others that depend on it.</p>
+        <p>Would you like to let students continue in the course or do you want to re-lock these modules until the new requirements are completed?</p>
+      </div>
+      <footer><button className="hx-button" onClick={() => confirm('relock')}>Re-Lock Modules</button>
+        <button className="hx-primary" onClick={() => confirm('continue')}>Continue</button>
+      </footer>
+    </section>
+  </div>;
+}
+
+function practiceSubmission(submissions, id) {
+  return submissions.find(s => s.user_id === id && s.assignment_id === 6111 && s.submitted_at);
+}
+
+function learnerAccess(policy, submissions, id) {
+  const score = submissions.find(s => s.user_id === id && s.assignment_id === 6101)?.score;
+  const diagnosticMet = score >= policy.minimum;
+  const excused = policy.exemptions.includes(id);
+  const submitted = Boolean(practiceSubmission(submissions, id)) || policy.practiceCompleted.includes(id);
+  const practiceMet = excused || (policy.practiceCriterion === 'submit' && submitted) ||
+    (policy.practiceCriterion === 'view' && policy.practiceViewed.includes(id));
+  const qualifies = policy.practiceCriterion ?
+    (policy.requirementMode === 'one' ? diagnosticMet || practiceMet : diagnosticMet && practiceMet) : diagnosticMet;
+  return {score, excused, submitted, qualifies, allowed: policy.previousProgress.includes(id) || qualifies};
+}
+
+function ModuleProgress({students, policy, submissions}) {
+  const [selected, setSelected] = useState(students[0].id);
+  const learner = students.find(u => u.id === selected);
+  const access = learnerAccess(policy, submissions, selected);
+  const previouslyStarted = policy.previousProgress.includes(selected);
+  return <>
+    <div className="hx-module-toolbar"><h1>Module Progress</h1><Link className="hx-button" to={modules}>Back to Modules</Link></div>
+    <div className="hx-progress">
+      <aside><h2>Student Progress</h2>{students.map(u =>
+        <button key={u.id} aria-pressed={selected === u.id} onClick={() => setSelected(u.id)}>{u.name}</button>)}</aside>
+      <section><h2>{learner.name}</h2>
+        <div><span>Retake eligibility</span><span>{access.qualifies ? 'Complete' : 'In Progress'}</span></div>
+        <div><span>Retake assessment</span><span>{previouslyStarted ? 'In Progress' : access.allowed ? 'Unlocked' : 'Locked'}</span></div>
+      </section>
+    </div>
+  </>;
+}
+
+function Gradebook({students, submissions, policy, update}) {
+  const [cell, setCell] = useState(null);
+  const [entered, setEntered] = useState('');
+  const [tray, setTray] = useState(null);
+  const commit = (id, mark) => {
+    if (/^EX$/i.test(mark.trim())) update(id, true);
+    if (!mark.trim() || mark.trim() === '–') update(id, false);
+    setCell(null);
+  };
+  return <>
+    <h1>Gradebook</h1>
+    <table className="hx-grades"><thead><tr><th>Student Name</th><th>Diagnostic <small>Out of 100</small></th><th>Practice workbook <small>Out of 0</small></th></tr></thead>
+      <tbody>{students.map(student => {
+        const excused = policy.exemptions.includes(student.id);
+        const submitted = practiceSubmission(submissions, student.id);
+        return <tr key={student.id}><th scope="row">{student.name}</th><td>{submissions.find(s => s.user_id === student.id && s.assignment_id === 6101)?.score ?? '–'}</td>
+          <td className={excused ? 'hx-excused' : ''}><div className="hx-grade-cell">
+            {cell === student.id ? <input autoFocus aria-label={student.name + ' practice grade'} value={entered}
+              onFocus={e => e.target.select()} onChange={e => setEntered(e.target.value)} onBlur={() => commit(student.id, entered)}
+              onKeyDown={e => {if(e.key === 'Enter') e.target.blur(); if(e.key === 'Escape') setCell(null);}}/>
+              : <button onClick={() => {setEntered(excused ? 'EX' : ''); setCell(student.id);}} aria-label={student.name + ' practice grade'}>{excused ? 'EX' : submitted ? 'Submitted' : '–'}</button>}
+            <button aria-label={'Grade Detail Tray for ' + student.name} onClick={() => setTray(student)}><MoreVertical size={17}/></button>
+          </div></td></tr>;
+      })}</tbody>
+    </table>
+    {tray && <aside className="hx-grade-tray" aria-label="Grade Detail Tray">
+      <header><h2>{tray.name}</h2><button aria-label="Close Grade Detail Tray" onClick={() => setTray(null)}><X size={20}/></button></header>
+      <p>Practice workbook</p>
+      {practiceSubmission(submissions, tray.id) && <p>Submitted {practiceSubmission(submissions, tray.id).submitted_at.slice(0, 10)}</p>}
+      <h3>Status</h3>
+      <label className="hx-radio"><input type="radio" checked={!policy.exemptions.includes(tray.id)} onChange={() => update(tray.id, false)}/> None</label>
+      <label className="hx-radio"><input type="radio" checked={policy.exemptions.includes(tray.id)} onChange={() => update(tray.id, true)}/> Excused</label>
+    </aside>}
+  </>;
+}
+
+export default function RetakeCourse() {
+  const {state, setState} = useAppContext();
+  const {pathname} = useLocation();
+  const navigate = useNavigate();
+  const policy = state.retakePolicy;
+  const current = state.currentUser;
+  const student = current.role === 'student';
+  const accountStudents = state.users.filter(user => user.role === 'student');
+  const students = accountStudents.filter(user => state.enrollments.some(e => e.course_id === 61 && e.user_id === user.id));
+  const enrolled = students.some(user => user.id === current.id);
+  const [menu, setMenu] = useState(false);
+  const [editing, setEditing] = useState(false);
+  const [pending, setPending] = useState(null);
+  const [collapsed, setCollapsed] = useState({});
+  const change = updates => setState(s => ({
+    ...s, retakePolicy: {...s.retakePolicy, ...updates, revision: s.retakePolicy.revision + 1}
+  }));
+  const editExcused = (id, excused) => {
+    if (policy.exemptions.includes(id) === excused) return;
+    change({exemptions: excused ? [...policy.exemptions, id] : policy.exemptions.filter(user => user !== id)});
+  };
+
+  const {score, excused: practiceExcused, submitted, allowed} = learnerAccess(policy, state.submissions, current.id);
+
+  const retakePage = pathname === retake || pathname === course + '/retake';
+
+  useEffect(() => {
+    if (!student || !enrolled) return;
+    if (retakePage) {
+      setState(s => {
+        const {retakePolicy: p} = s;
+        const observation = {userId: current.id, route: 'retake', allowed, revision: p.revision, role: 'student'};
+        if (p.observations.some(o => o.userId === current.id && o.revision === p.revision && o.allowed === allowed)) return s;
+        return {...s, retakePolicy: {...p, observations: [...p.observations, observation]}};
+      });
+    }
+    if (pathname === practice && !policy.practiceViewed.includes(current.id) && !practiceExcused) {
+      setState(s => ({...s, retakePolicy: {...s.retakePolicy, practiceViewed: [...s.retakePolicy.practiceViewed, current.id]}}));
+    }
+  }, [pathname, current.id, policy.revision]);
+
+  const coursePeople = pathname === course + '/users';
+  const accountPeople = pathname === people;
+  const accountUser = pathname.match(/^\/accounts\/1\/users\/(\d+)(\/masquerade)?$/);
+  const person = accountStudents.find(user => user.id === Number(accountUser?.[1]));
+  const actingAs = Boolean(accountUser?.[2]);
+  const grades = pathname === course + '/grades';
+  const announcementList = pathname === announcements;
+  const announcement = state.announcements.find(a => a.course_id === 61 && pathname === announcements + '/' + a.id);
+  const moduleProgress = pathname === progress;
+  if (student && (accountPeople || accountUser || coursePeople || announcementList || announcement || moduleProgress)) return <Navigate to={modules} replace/>;
+
+  const saveSettings = values => {
+    setEditing(false);
+    if (Object.keys(values).every(key => values[key] === policy[key])) return;
+    if (policy.previousProgress.length) {
+      setPending(values);
+    } else {
+      change(values);
+    }
+  };
+  const resolveProgress = decision => {
+    change({...pending, progressionDecision: decision, previousProgress: decision === 'continue' ? policy.previousProgress : []});
+    setPending(null);
+  };
+
+  const stopActing = () => {
+    const roleOwner = state.users.find(user => user.id === state.actingAccountId);
+    if (!roleOwner) return;
+    setState({currentUser: roleOwner, actingAccountId: null});
+    navigate(people);
+  };
+
+  const nav = student ? [['Home', modules], ['Modules', modules], ['Grades', course + '/grades']] :
+    [['Home', course], ['Announcements', announcements], ['Modules', modules], ['Grades', course + '/grades'], ['People', course + '/users']];
+
+  return <div className="app-layout hx16"><GlobalNav/><div className="main-content">
+    <div className="course-layout">
+      <div className="hx-breadcrumb"><Menu size={20}/><Link to={accountPeople || accountUser ? people : modules}>{accountPeople || accountUser ? 'Field Methods Institute' : 'Field Methods | November'}</Link>
+        <span>›</span><span>{accountPeople || coursePeople ? 'People' : accountUser ? person?.name : grades ? 'Grades' : (announcementList || announcement) ? 'Announcements' : moduleProgress ? 'Module Progress' : 'Modules'}</span>
+      </div>
+      <div className="course-body">
+        <nav className="course-nav-sidebar" aria-label={accountPeople || accountUser ? 'Account Navigation' : 'Course Navigation'}>
+          {(accountPeople || accountUser ? [['People', people], ['Courses', modules]] : nav).map(([title, path]) =>
+            <NavLink key={title} to={path} end className={({isActive}) => 'course-nav-item' + (isActive && title !== 'Home' ? ' active' : '')}>{title}</NavLink>)}
+        </nav>
+        <main className="course-content-area">
+          {student && !enrolled ? <><h1>Unauthorized</h1><p>You are not enrolled in this course.</p></> : <>
+          {(coursePeople || accountPeople) && <><h1>People</h1>{coursePeople && <p><Link to={people}>Account People</Link></p>}
+            <table className="hx-people"><thead><tr><th>Name</th><th>Login ID</th><th>Role</th></tr></thead>
+              <tbody>{(accountPeople ? accountStudents : students).map(user => <tr key={user.id}><td><Link to={people + '/' + user.id}>{user.name}</Link></td><td>{user.email}</td><td>Student</td></tr>)}</tbody>
+            </table></>}
+          {person && !actingAs && <><h1>{person.name}</h1><div className="hx-profile"><div><h2>Login Information</h2><p>{person.email}</p></div>
+            <Link className="hx-button" to={people + '/' + person.id + '/masquerade'}>Act as User</Link></div></>}
+          {person && actingAs && <div className="hx-confirm"><h1>Act as User</h1>
+            <p>You are about to act as {person.name}. While acting as this user, any actions you take will be recorded in the audit log.</p>
+            <div className="hx-confirm-actions"><Link className="hx-button" to={people + '/' + person.id}>Cancel</Link>
+              <button className="hx-primary" onClick={() => {setState({currentUser: person, actingAccountId: current.id}); navigate(modules);}}>Proceed</button></div>
+          </div>}
+          {grades && !student && <Gradebook students={students} submissions={state.submissions} policy={policy} update={editExcused}/>}
+          {grades && student && <><h1>Grades for {current.name}</h1><table className="hx-people">
+            <thead><tr><th>Name</th><th>Score</th></tr></thead><tbody><tr><td>Diagnostic</td><td>{score}/100</td></tr><tr><td>Practice workbook</td><td>{practiceExcused ? 'EX' : submitted ? 'Submitted' : '–'}</td></tr></tbody></table></>}
+          {announcementList && <><h1>Announcements</h1><ul className="hx-announcements">{state.announcements.filter(a => a.course_id === 61).map(a =>
+            <li key={a.id}><Link to={announcements + '/' + a.id}>{a.title}</Link><time>{a.posted_at}</time></li>)}</ul></>}
+          {announcement && <article><h1>{announcement.title}</h1><div className="hx-announcement-body">{announcement.body}</div>
+            {announcement.id === 6160 && <p><Link to={retake}>Retake instructions</Link></p>}</article>}
+          {moduleProgress && <ModuleProgress students={students} policy={policy} submissions={state.submissions}/>}
+          {retakePage && <article>
+            <h1>Retake instructions</h1>
+            {student && !allowed ? <div className="hx-lock" role="status"><Lock size={19}/> This page is part of the module Retake assessment and hasn’t been unlocked yet. Complete an eligible requirement in Retake eligibility.<p><Link to={modules}>Back to Modules</Link></p></div>
+              : <p>Bring your field notebook and the sampling plan to the retake session. You will work through a new set of practice-site observations independently.</p>}
+          </article>}
+          {pathname === practice && <article><h1>Practice workbook</h1><p>Review the field sampling procedures, then submit your practice responses.</p>
+            {student && (practiceExcused ? <p>Excused</p> : submitted ? <><p>Submitted</p>{practiceSubmission(state.submissions, current.id) && <p>Submitted on {practiceSubmission(state.submissions, current.id).submitted_at.slice(0, 10)}</p>}</> :
+              <form onSubmit={e => {e.preventDefault(); change({practiceCompleted: [...policy.practiceCompleted, current.id]});}}>
+                <label className="hx-field">Text Entry<textarea required/></label><button className="hx-primary">Submit Assignment</button></form>)}
+          </article>}
+          {pathname === course + '/assignments/6101' && <article><h1>Diagnostic</h1><p>Points: 100</p>{student && <p>Grade: {score}/100</p>}</article>}
+          {(pathname === modules || pathname === course || pathname === course + '/') && <>
+            <div className="hx-module-toolbar"><h1>Modules</h1>{!student && <Link className="hx-button" to={progress}>View Progress</Link>}</div>
+            {[{id: 'eligibility', name: label, items: [['Diagnostic', course + '/assignments/6101', 'Score at least ' + policy.minimum], ['Practice workbook', practice, policy.practiceCriterion === 'submit' ? 'Submit the assignment' : policy.practiceCriterion === 'view' ? 'View the item' : '']]},
+              {id: 'retake', name: 'Retake assessment', items: [['Retake instructions', retake, '']]}].map((module) => {
+              const eligibility = module.id === 'eligibility';
+              const locked = student && !eligibility && !allowed;
+              return <section key={module.id} className="hx-module">
+                <div className="module-header-bar">
+                  <div className="module-header-left">{!student && <GripVertical size={16}/>}
+                    <button aria-expanded={!collapsed[module.id]} aria-label={'Toggle ' + module.name} onClick={() => setCollapsed({...collapsed, [module.id]: !collapsed[module.id]})}><ChevronDown size={16}/></button>
+                    <span className="module-name">{module.name}</span>
+                    <small>{eligibility ? (policy.requirementMode === 'one' ? 'Complete One Item' : 'Complete All Items') : 'Prerequisites: ' + label}</small>
+                  </div>
+                  <div className="module-header-right">
+                    {locked ? <Lock size={18}/> : (!student || eligibility && allowed) && <CheckCircle2 className="hx-published" size={18}/>}
+                    {!student && eligibility && <button className="module-kebab-btn" aria-label={module.name + ' options'} aria-expanded={menu} onClick={() => setMenu(!menu)}><MoreVertical size={18}/></button>}
+                  </div>
+                  {!student && eligibility && menu && <div className="hx-menu"><button onClick={() => {setMenu(false); setEditing(true);}}>Edit</button></div>}
+                </div>
+                {!collapsed[module.id] && module.items.map(([title, href, requirement]) =>
+                  <div className="hx-module-item" key={href}>{eligibility ? <ClipboardList size={18}/> : <FileText size={18}/>}
+                    {locked ? <span>{title}</span> : <Link to={href}>{title}</Link>}<small>{requirement}</small>{locked && <Lock size={15}/>}
+                  </div>)}
+              </section>;
+            })}
+          </>}
+        </>}</main>
+      </div>
+    </div>
+    {student && state.actingAccountId && <div className="hx-act-as"><span>You are currently acting as {current.name}.</span><button onClick={stopActing}>Stop Acting as User</button></div>}
+    {!student && editing && <Settings policy={policy} dismiss={() => setEditing(false)} save={saveSettings}/>}
+    {!student && pending && <EligibilityChange dismiss={() => setPending(null)} confirm={resolveProgress}/>}
+  </div></div>;
+}
