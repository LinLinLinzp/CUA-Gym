diff --git a/src/pages/GlobalAnnouncements.jsx b/src/pages/GlobalAnnouncements.jsx
new file mode 100644
--- /dev/null
+++ b/src/pages/GlobalAnnouncements.jsx
@@ -0,0 +1,88 @@
+import React, {useLayoutEffect, useRef, useState} from 'react';
+import {Link} from 'react-router-dom';
+import {useAppContext} from '../context/AppContext';
+import closeIcon from '../components/canvas-close.svg';
+import informationIcon from '../components/canvas-information.svg';
+import './GlobalAnnouncements.css';
+
+function visibleNotices(state) {
+  return state.globalAnnouncements.filter(notice => notice.role === state.currentUser.role);
+}
+
+function Notice({notice, onClose}) {
+  return (
+    <article className="account-notice">
+      <div className="account-notice-icon" aria-hidden="true"><img src={informationIcon} alt="" /></div>
+      <div className="account-notice-content">
+        <h2>{notice.subject}</h2>
+        <p>{notice.message}</p>
+        <small>This is an announcement from <strong>{notice.account}</strong></small>
+      </div>
+      {onClose && <button type="button" className="account-notice-close"
+        aria-label="Close announcement" title="Close" onClick={onClose}><img src={closeIcon} alt="" /></button>}
+    </article>
+  );
+}
+
+export function DashboardAnnouncements() {
+  const {state, setState} = useAppContext();
+  const [showConfirmation, setShowConfirmation] = useState(false);
+  const viewLink = useRef(null);
+  const account = state.currentUser.id;
+  const dismissed = (state.dismissedGlobalAnnouncements || {})[account] || [];
+
+  useLayoutEffect(() => {
+    if (showConfirmation) viewLink.current?.focus();
+  }, [showConfirmation]);
+
+  function dismiss(notice) {
+    setState(previous => {
+      const dismissals = previous.dismissedGlobalAnnouncements || {};
+      return {
+        ...previous,
+        dismissedGlobalAnnouncements: {
+          ...dismissals,
+          [account]: [...new Set([...(dismissals[account] || []), notice.id])],
+        },
+      };
+    });
+    setShowConfirmation(true);
+  }
+
+  return (
+    <>
+      {visibleNotices(state).filter(notice => !dismissed.includes(notice.id)).map(notice =>
+        <Notice key={notice.id} notice={notice} onClose={() => dismiss(notice)} />)}
+      {showConfirmation && (
+        <div className="account-notice" role="status">
+          <div className="account-notice-icon" aria-hidden="true"><img src={informationIcon} alt="" /></div>
+          <div className="account-notice-content">
+            <div>You can view dismissed announcements by going to Account and selecting Global Announcements from the menu.</div>
+            <Link ref={viewLink} className="account-notice-view" to="/account_notifications">View</Link>
+          </div>
+          <button type="button" className="account-notice-close" aria-label="Close confirmation"
+            onClick={() => {
+              setShowConfirmation(false);
+              document.querySelector('.dashboard-header h1')?.focus();
+            }}><img src={closeIcon} alt="" /></button>
+        </div>
+      )}
+    </>
+  );
+}
+
+export function GlobalAnnouncementsPage() {
+  const {state} = useAppContext();
+  const [recent, setRecent] = useState(false);
+  return (
+    <main className="dashboard-page global-announcements-page">
+      <h1>Global Announcements</h1>
+      <div className="announcement-tabs" role="group" aria-label="Announcement period">
+        <button type="button" aria-pressed={!recent} onClick={() => setRecent(false)}>Current</button>
+        <button type="button" aria-pressed={recent} onClick={() => setRecent(true)}>Recent</button>
+      </div>
+      <p>{recent ? 'Announcements from the past four months' : 'Active Announcements'}</p>
+      {!recent && visibleNotices(state).map(notice => <Notice key={notice.id} notice={notice} />)}
+    </main>
+  );
+}
