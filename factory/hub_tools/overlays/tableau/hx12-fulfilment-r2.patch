+import React, {useState} from 'react'
+import {fieldTypes, operators} from '../utils/fulfilmentEngine'
+
+function FieldList({side, active, pairs, choose, setActive}) {
+ const [search, setSearch] = useState('')
+ const fields = fieldTypes[side]
+ return <div className="hx-relation-fields">
+   <strong>{side === 'left' ? 'Orders' : 'Parcels'}</strong>
+   {pairs.map((pair, index) => <button key={index} className={active === index ? 'active' : ''} onClick={() => setActive(index)}>
+     {pair[side] && <span>{fields[pair[side]]}</span>}{pair[side] || 'Select a field'}
+   </button>)}
+   <input type="search" aria-label={side === 'left' ? 'Search Orders fields' : 'Search Parcels fields'} placeholder="Search" value={search} onChange={e => setSearch(e.target.value)}/>
+   <div className="hx-relation-list">
+     {Object.entries(fields).filter(([name]) => name.toLowerCase().includes(search.trim().toLowerCase())).map(([name, type]) =>
+       <button key={name} onClick={() => choose(side, name)} disabled={Boolean(pairs[active][side === 'left' ? 'right' : 'left'] && type !== fieldTypes[side === 'left' ? 'right' : 'left'][pairs[active][side === 'left' ? 'right' : 'left']])}><span>{type}</span>{name}</button>)}
+   </div>
+ </div>
+}
+
+export default function RelationshipEditor({pairs, save, close}) {
+ const [active, setActive] = useState(0)
+ const [pending, setPending] = useState(pairs)
+ const complete = pending.every(pair => pair.left && pair.right)
+ function edit(changes) {
+   const next = pending.map((pair, index) => index === active ? {...pair, ...changes} : pair)
+   setPending(next)
+   if (next.every(pair => pair.left && pair.right)) save(next)
+ }
+ function remove() {
+   const next = pending.filter((_, index) => index !== active)
+   setActive(0)
+   setPending(next)
+   if (next.every(pair => pair.left && pair.right)) save(next)
+ }
+ return <section className="hx-relationship-panel" aria-label="Edit Relationship">
+   <header><strong>Edit Relationship</strong><button aria-label="Dismiss relationship editor" onClick={close}>×</button></header>
+   <div className="hx-relation-body">
+     <FieldList side="left" active={active} pairs={pending} choose={(side, name) => edit({[side]: name})} setActive={setActive}/>
+     <div className="hx-relation-operators"><span>Operator</span>{pending.map((pair, index) =>
+       <select key={index} aria-label={'Operator for pair ' + (index + 1)} value={pair.operator} onChange={e => {
+         const next = pending.map((clause, position) => position === index ? {...clause, operator: e.target.value} : clause)
+         setPending(next)
+         if (complete) save(next)
+       }}>{operators.map(operator => <option key={operator}>{operator}</option>)}</select>)}</div>
+     <FieldList side="right" active={active} pairs={pending} choose={(side, name) => edit({[side]: name})} setActive={setActive}/>
+   </div>
+   <footer>
+     <button disabled={!complete} onClick={() => {setActive(pending.length);setPending([...pending,{left:'',operator:'=',right:''}])}}>Add more fields</button>
+     <button disabled={pending.length < 2} onClick={remove}>Remove pair</button>
+     <button onClick={close}>Close</button>
+   </footer>
+ </section>
+}
