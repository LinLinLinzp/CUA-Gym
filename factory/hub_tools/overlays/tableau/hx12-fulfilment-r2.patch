+function compareFields(a, op, b) {
+ if (a == null || b == null || typeof a !== typeof b) return false
+ switch (op) {
+  case '=': return a === b
+  case '<>': return a !== b
+  case '<': return a < b
+  case '<=': return a <= b
+  case '>': return a > b
+  case '>=': return a >= b
