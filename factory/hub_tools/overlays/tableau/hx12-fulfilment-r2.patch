+import {aggregate,expression} from './fulfilmentEngine'
+
+function expandFixed(formula, rows, universe=rows) {
+ let dataset = rows
+ let index = 0
+ const template = formula.replace(/\{\s*FIXED\s+((?:\[[^\]]+\]\s*,?\s*)+)\s*:\s*([^{}]+)\}/gi, (_, fields, calculation) => {
+   const names = [...fields.matchAll(/\[([^\]]+)\]/g)].map(match => match[1])
+   const alias = '__fixed' + index++
+   const groups = new Map()
+   const keyFor = row => {
+     if (names.some(name => !Object.hasOwn(row,name))) throw Error('Unknown FIXED dimension')
+     return JSON.stringify(names.map(name => row[name]))
+   }
+   universe.forEach(row => {
+     const key = keyFor(row)
+     if (!groups.has(key)) groups.set(key, [])
+     groups.get(key).push(row)
+   })
+   const values = new Map([...groups].map(([key,group]) => [key,aggregate(calculation,group)]))
+   dataset = dataset.map(row => ({...row,[alias]:values.get(keyFor(row))}))
+   return '['+alias+']'
+ })
+ return {template,dataset}
+}
+
+export function evaluateMetric(formula, rows, universe=rows) {
+ const {template,dataset} = expandFixed(formula,rows,universe)
+ return aggregate(template,dataset)
+}
+
+export function materialize(model, rows) {
+ const pending = Object.entries(model.calculations).filter(([name]) => !['Eligible orders','Complete orders'].includes(name))
+ let data = rows
+ while (pending.length) {
+   const index = pending.findIndex(([,formula]) => {
+     const references = [...formula.matchAll(/\[([^\]]+)\]/g)].map(match => match[1])
+     return references.every(name => !pending.some(([pendingName]) => pendingName===name))
+   })
+   if (index < 0) throw Error('Circular calculated field reference')
+   const [[name,formula]] = pending.splice(index,1)
+   const {template,dataset} = expandFixed(formula,data)
+   data = data.map((row,i) => ({...row,[name]:expression(template,dataset[i])}))
+ }
+ return data
+}
