+ function atom(){let t=tokens[i++];if(t===undefined)throw Error('Expected expression');if(t==='('){const v=condition();if(tokens[i++]!==')')throw Error('Expected )');return v}if(t.toUpperCase()==='IF'){const yes=condition();if(tokens[i++].toUpperCase()!=='THEN')throw Error('Expected THEN');const a=condition();let b=null;if(tokens[i]?.toUpperCase()==='ELSE'){i++;b=condition()}if(tokens[i++]?.toUpperCase()!=='END')throw Error('Expected END');return yes?a:b}if(t.startsWith('[')){const field=t.slice(1,-1);if(!Object.hasOwn(context,field))throw Error('Unknown field '+t);return context[field]}if(t.startsWith('"')||t.startsWith("'"))return t.slice(1,-1);if(/^\d/.test(t))return Number(t);if(t.toUpperCase()==='TRUE')return true;if(t.toUpperCase()==='FALSE')return false;throw Error('Unknown expression '+t)}
+ function term(){let v=atom();while(['*','/'].includes(tokens[i])){const op=tokens[i++],b=atom();v=op==='*'?v*b:v/b}return v}
+ function math(){let v=term();while(['+','-'].includes(tokens[i])){const op=tokens[i++],b=term();v=op==='+'?v+b:v-b}return v}
+ function compare(){let a=math();if(['=','<>','<','>','<=','>='].includes(tokens[i])){let op=tokens[i++],b=math();return op==='='?a===b:op==='<>'?a!==b:op==='<'?a<b:op==='>'?a>b:op==='<='?a<=b:a>=b}return a}
