diff --git a/src/site-editor/SiteEditor.jsx b/src/site-editor/SiteEditor.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..ac77ac0da7caa8480ea6770263156fec0a779ccb
--- /dev/null
+++ b/src/site-editor/SiteEditor.jsx
@@ -0,0 +1,424 @@
+import React, { useEffect, useRef, useState } from 'react'
+import { useParams, useSearchParams } from 'react-router-dom'
+import { useStore } from '../data/store.jsx'
+import { dashboardPath, routePath, SiteLink, useSessionRouting } from '../utils/navigation.jsx'
+import wordpress from './icon-wordpress.jsx'
+import listView from './icon-list-view.jsx'
+import more from './icon-more-vertical.jsx'
+import down from './icon-chevron-down.jsx'
+import right from './icon-chevron-right.jsx'
+import group from './icon-group.jsx'
+import heading from './icon-heading.jsx'
+import paragraph from './icon-paragraph.jsx'
+import external from './icon-external.jsx'
+import pattern from './icon-reusable-block.jsx'
+import arrowUp from './icon-arrow-up.jsx'
+import arrowDown from './icon-arrow-down.jsx'
+import undo from './icon-undo.jsx'
+import redo from './icon-redo.jsx'
+import desktop from './icon-desktop.jsx'
+import close from './icon-close.jsx'
+import './site-editor.css'
+
+const editor = '/wp-admin/site-editor.php'
+const front = (slug) => '/exhibitions/' + slug + '/'
+const tabs = { pages: 'Pages', templates: 'Templates', patterns: 'Patterns' }
+const iconFor = { group, heading, paragraph, reference: pattern, link: external, content: paragraph }
+const nameFor = { group: 'Group', heading: 'Heading', paragraph: 'Paragraph', reference: 'Pattern', link: 'Button', content: 'Post Content' }
+const pathFor = (kind, id) => routePath(editor, { path: '/' + kind, ...(id ? { postType: kind === 'templates' ? 'wp_template' : 'wp_block', postId: id, canvas: 'edit' } : {}) })
+const titleFor = (block, patterns) => block.type === 'reference' ? patterns[block.ref]?.title || 'Unavailable pattern' : block.label || nameFor[block.type]
+
+function find(blocks, id) {
+  for (const block of blocks) {
+    if (block.id === id) return block
+    const found = block.children && find(block.children, id)
+    if (found) return found
+  }
+  return null
+}
+
+function revise(blocks, id, apply) {
+  return blocks.flatMap((block) => block.id === id
+    ? apply(block)
+    : [block.children ? { ...block, children: revise(block.children, id, apply) } : block])
+}
+
+function relocate(blocks, source, target, after) {
+  const from = blocks.findIndex((block) => block.id === source)
+  if (from >= 0) {
+    if (source === target || !blocks.some((block) => block.id === target)) return blocks
+    const reordered = [...blocks]
+    const [block] = reordered.splice(from, 1)
+    const destination = reordered.findIndex((block) => block.id === target)
+    reordered.splice(destination + Number(after), 0, block)
+    return reordered
+  }
+  return blocks.map((block) => block.children ? { ...block, children: relocate(block.children, source, target, after) } : block)
+}
+
+function siblingList(blocks, id) {
+  if (blocks.some((block) => block.id === id)) return blocks
+  for (const block of blocks) {
+    const found = block.children && siblingList(block.children, id)
+    if (found) return found
+  }
+  return null
+}
+
+function Blocks({ blocks, site, page, selected, onSelect, onEdit, readonly = false }) {
+  return blocks.map((block) => {
+    const className = [
+      'hx26-block',
+      selected === block.id && !readonly ? 'hx26-selected' : '',
+      block.className || '',
+    ].filter(Boolean).join(' ')
+    const props = { className, ...(block.anchor ? { id: block.anchor } : {}) }
+    if (onSelect && !readonly) props.onClick = (event) => { event.stopPropagation(); onSelect(block.id) }
+    if (block.type === 'group') return <section key={block.id} {...props}><Blocks {...{ site, page, selected, onSelect, onEdit, readonly }} blocks={block.children} /></section>
+    if (block.type === 'reference') {
+      const entity = site.patterns[block.ref]?.status === 'publish' ? site.patterns[block.ref] : null
+      return <section key={block.id} {...props} className={className + ' hx26-pattern-instance'}>{entity
+        ? <Blocks blocks={entity.blocks} site={site} page={page} readonly />
+        : <p>Block has been deleted or is unavailable.</p>}</section>
+    }
+    if (block.type === 'content') return <div key={block.id} {...props}>{page?.intro}</div>
+    if (block.type === 'link') return onSelect ? <div key={block.id} {...props}><span className="hx26-public-button">{block.text}</span></div> : <p key={block.id} {...props}><a className="hx26-public-button" href={block.url}>{block.text}</a></p>
+    const Tag = block.type === 'heading' ? 'h2' : 'p'
+    if (onEdit && selected === block.id && !readonly) {
+      return <Tag key={block.id} {...props}>
+        <input aria-label={'Edit ' + (block.label || nameFor[block.type])} value={block.text} onChange={(event) => onEdit(block.id, event.target.value)} />
+      </Tag>
+    }
+    return <Tag key={block.id} {...props}>{block.text}</Tag>
+  })
+}
+
+function Exhibition({ slug, site, edit, miniature = false }) {
+  const page = site.pages[slug]
+  const template = site.templates[page?.template]
+  if (!page || !template || page.status !== 'publish' || template.status !== 'publish') {
+    return <main className="hx26-front hx26-unavailable"><h1>Exhibition unavailable</h1><SiteLink to={dashboardPath}>Return to Dashboard</SiteLink></main>
+  }
+  return <div className="hx26-front">
+    <header className="hx26-public-header">
+      <strong>{site.title}</strong>
+      {!miniature && <nav aria-label="Exhibitions">
+        {Object.entries(site.pages).filter(([, item]) => item.status === 'publish').map(([id, item]) =>
+          edit ? <span key={id}>{item.shortTitle}</span> : <SiteLink key={id} aria-current={id === slug ? 'page' : undefined} to={front(id)}>{item.shortTitle}</SiteLink>)}
+      </nav>}
+    </header>
+    <main>
+      <div className="hx26-hero" style={{ backgroundImage: 'linear-gradient(90deg, #102f2be8, #102f2b4d), url(/media/' + page.image + ')' }}>
+        <span>{page.room}</span><h1>{page.title}</h1><p>{page.subtitle}</p>
+      </div>
+      <article className="hx26-public-blocks"><Blocks blocks={template.blocks} site={site} page={page} {...edit} /></article>
+    </main>
+    <footer className="hx26-public-header">{site.title} <span>14 Foundry Lane · Saint Port</span></footer>
+  </div>
+}
+
+export function ExhibitionRoute() {
+  const { state } = useStore()
+  const { slug } = useParams()
+  const [params] = useSearchParams()
+  const [preview, setPreview] = useState()
+  const previewKey = params.get('preview')
+  useEffect(() => {
+    if (!previewKey) return
+    try { setPreview(JSON.parse(sessionStorage.getItem('hx26-preview-' + previewKey))) } catch { setPreview(null) }
+  }, [previewKey])
+  if (!state.hx26) return <main className="neutral">Exhibition unavailable</main>
+  if (previewKey && !preview) return <main className="neutral">Preview unavailable. Open Preview from the Site Editor again.</main>
+  return <>{preview && <div className="hx26-preview-banner">Preview · Unsaved changes <SiteLink to={routePath(editor, { path: '/templates', postType: 'wp_template', postId: preview.pages[slug]?.template, canvas: 'edit' })}>Edit template</SiteLink></div>}
+    <Exhibition slug={slug} site={preview || state.hx26} /></>
+}
+
+function IconButton({ icon, label, ...props }) {
+  return <button type="button" className="hx26-icon" aria-label={label} title={label} {...props}>{icon}</button>
+}
+
+function Catalog({ site, kind, handover }) {
+  const collection = site[kind]
+  return <div className="hx26-browser">
+    <aside className="hx26-browser-nav">
+      <SiteLink className="hx26-browser-brand" aria-label="Dashboard" to={dashboardPath}>{wordpress}</SiteLink>
+      <h1>Design</h1><p>Manage the look and feel of your site.</p>
+      <nav aria-label="Design">
+        {Object.entries(tabs).map(([key, label]) => <SiteLink key={key} aria-current={key === kind ? 'page' : undefined} to={pathFor(key)}>{label}{right}</SiteLink>)}
+      </nav>
+      <SiteLink className="hx26-visit" to={front(site.home)}>View site {external}</SiteLink>
+    </aside>
+    {kind ? <main className="hx26-catalog"><h1>{tabs[kind]}</h1>
+      {kind === 'pages' ? <><table><thead><tr><th>Title</th><th>Template</th><th>Status</th><th></th></tr></thead>
+        <tbody>{Object.entries(collection).map(([id, page]) => <tr key={id}><td>{page.title}</td><td>{site.templates[page.template]?.title || 'Unavailable'}</td><td>{page.status === 'publish' ? 'Published' : 'Draft'}</td><td><SiteLink to={front(id)}>View page</SiteLink></td></tr>)}</tbody></table>
+        <h2>WordPress pages</h2><SiteLink to={handover}>Visitor desk changeover</SiteLink>
+      </> : <div className="hx26-cards">{Object.entries(collection).map(([id, entity]) =>
+        <article key={id} className="hx26-card">
+          <div className="hx26-miniature" aria-hidden="true" inert="">
+            {kind === 'templates' ? <Exhibition slug={Object.entries(site.pages).find(([, page]) => page.template === id)?.[0]} site={site} miniature /> : <Blocks blocks={entity.blocks} site={site} readonly />}
+          </div>
+          <div><SiteLink to={pathFor(kind, id)}><strong>{entity.title}</strong></SiteLink><small>{kind === 'patterns' ? 'Synced' : entity.description}</small></div>
+        </article>)}</div>}
+    </main> : <div className="hx26-home-preview"><Exhibition slug={site.home} site={site} /></div>}
+  </div>
+}
+
+function BlockList({ blocks, site, selected, onSelect, expanded, setExpanded, onMenu, drop, depth = 0 }) {
+  return <ul>{blocks.map((block) => <li key={block.id}>
+    <div data-block-id={block.id}
+      className={'hx26-row ' + (block.id === selected ? 'is-selected ' : '') + (block.type === 'reference' ? 'is-pattern ' : '') + (drop?.id === block.id ? (drop.after ? 'drop-after' : 'drop-before') : '')}
+      style={{ paddingLeft: 8 + depth * 20 }}>
+      {block.children ? <IconButton icon={expanded.has(block.id) ? down : right} label={(expanded.has(block.id) ? 'Collapse ' : 'Expand ') + titleFor(block, site.patterns)} aria-expanded={expanded.has(block.id)} onClick={() => setExpanded((old) => {
+        const next = new Set(old)
+        if (next.has(block.id)) next.delete(block.id)
+        else next.add(block.id)
+        return next
+      })} /> : <span className="hx26-twist-placeholder" />}
+      <button type="button" className="hx26-block-label" onClick={() => onSelect(block.id)}>{iconFor[block.type]}<span>{titleFor(block, site.patterns)}{block.anchor && <small> #{block.anchor}</small>}</span></button>
+      <IconButton icon={more} label={'Options for ' + titleFor(block, site.patterns)} onClick={(event) => onMenu(block.id, event.currentTarget.getBoundingClientRect())} />
+    </div>
+    {block.children && expanded.has(block.id) && <BlockList {...{ site, selected, onSelect, expanded, setExpanded, onMenu, drop }} depth={depth + 1} blocks={block.children} />}
+  </li>)}</ul>
+}
+
+function mergeSite(site, drafts) {
+  const next = { ...site, templates: { ...site.templates }, patterns: { ...site.patterns } }
+  for (const [key, entity] of Object.entries(drafts)) {
+    const [kind, id] = key.split(':')
+    next[kind][id] = entity
+  }
+  return next
+}
+
+function Editor({ store }) {
+  const [params] = useSearchParams()
+  const { href, go } = useSessionRouting()
+  const requested = params.get('path')?.slice(1)
+  const kind = tabs[requested] ? requested : ''
+  const id = params.get('postId')
+  const key = kind + ':' + id
+  const original = store.state.hx26
+  const [drafts, setDrafts] = useState({})
+  const baseline = useRef({})
+  const [past, setPast] = useState([])
+  const [future, setFuture] = useState([])
+  const [open, setOpen] = useState(false)
+  const drag = useRef(null)
+  const [drop, setDrop] = useState(null)
+  const [selected, setSelected] = useState('')
+  const [expanded, setExpanded] = useState(new Set())
+  const [menu, setMenu] = useState(null)
+  const [preview, setPreview] = useState(false)
+  const [settings, setSettings] = useState(false)
+  const [saving, setSaving] = useState(null)
+  const [status, setStatus] = useState('')
+  const [device, setDevice] = useState('Desktop')
+  const focusSnapshot = useRef('')
+  const site = mergeSite(original, drafts)
+  const entity = id && kind !== 'pages' && site[kind]?.[id]
+  const block = entity && find(entity.blocks, selected)
+  const dirty = Object.keys(drafts)
+  const pageOptions = Object.entries(site.pages).filter(([, page]) => kind === 'patterns' || page.template === id)
+  const currentPage = pageOptions.find(([slug]) => slug === params.get('previewPage'))?.[0] || pageOptions[0]?.[0] || site.home
+  const handover = routePath('/wp-admin/post.php', { post: original.handover, action: 'edit' })
+
+  useEffect(() => {
+    setSelected('')
+    setExpanded(new Set())
+    setMenu(null)
+    setPreview(false)
+    setSettings(false)
+    setStatus('')
+    focusSnapshot.current = ''
+  }, [key])
+  useEffect(() => {
+    const handler = (event) => {
+      if (event.key === 'Escape') { setMenu(null); setSaving(null); setPreview(false) }
+    }
+    const before = (event) => {
+      if (dirty.length) { event.preventDefault(); event.returnValue = '' }
+    }
+    window.addEventListener('keydown', handler)
+    window.addEventListener('beforeunload', before)
+    return () => { window.removeEventListener('keydown', handler); window.removeEventListener('beforeunload', before) }
+  }, [dirty.length])
+
+  if (!entity) return <Catalog site={site} kind={kind} handover={handover} />
+  const change = (blocks, type = '') => {
+    if (JSON.stringify(blocks) === JSON.stringify(entity.blocks)) return
+    if (!(key in baseline.current)) baseline.current[key] = original[kind][id]
+    const updated = { ...entity, blocks }
+    const next = { ...drafts, [key]: updated }
+    if (JSON.stringify(updated) === JSON.stringify(original[kind][id])) delete next[key]
+    if (!type || focusSnapshot.current !== type) setPast([...past, drafts])
+    focusSnapshot.current = type
+    setFuture([])
+    setDrafts(next)
+    setStatus('')
+  }
+  const travel = (redoing) => {
+    focusSnapshot.current = ''
+    const stack = redoing ? future : past
+    if (!stack.length) return
+    setDrafts(stack.at(-1))
+    if (redoing) { setFuture(stack.slice(0, -1)); setPast([...past, drafts]) }
+    else { setPast(stack.slice(0, -1)); setFuture([...future, drafts]) }
+    setStatus('')
+  }
+  const onSelect = (target) => {
+    focusSnapshot.current = ''
+    setSelected(target)
+  }
+  const openMenu = (target, rect) => {
+    onSelect(target)
+    setMenu({ target, x: Math.min(rect.left, window.innerWidth - 236), y: Math.min(rect.bottom + 3, window.innerHeight - 186) })
+  }
+  const edit = (target, text) => change(revise(entity.blocks, target, (item) => [{ ...item, text }]), target)
+  const detach = () => {
+    const source = site.patterns[block.ref]
+    if (source) {
+      change(revise(entity.blocks, block.id, () => structuredClone(source.blocks)))
+      setSelected(source.blocks[0]?.id || '')
+      setExpanded((old) => new Set([...old, ...source.blocks.map((item) => item.id)]))
+    }
+    setMenu(null)
+  }
+  const editOriginal = () => {
+    setMenu(null)
+    go(pathFor('patterns', block.ref))
+  }
+  const move = (offset) => {
+    const siblings = siblingList(entity.blocks, selected)
+    const index = siblings?.findIndex((item) => item.id === selected)
+    const destination = siblings?.[index + offset]
+    if (destination) change(relocate(entity.blocks, selected, destination.id, offset > 0))
+    setMenu(null)
+  }
+  const storeChanges = () => {
+    if (!saving.length) return
+    const result = store.commit((live) => {
+      for (const item of saving) {
+        const [entityType, entityId] = item.split(':')
+        if (JSON.stringify(live.hx26[entityType]?.[entityId]) !== JSON.stringify(baseline.current[item])) {
+          return { error: 'This item has changed in another tab. Reload before saving again.' }
+        }
+      }
+      const changes = Object.fromEntries(saving.map((item) => [item, drafts[item]]))
+      return { next: { ...live, hx26: mergeSite(live.hx26, changes) } }
+    })
+    if (result.error) { setStatus(result.error); setSaving(null); return }
+    setDrafts(Object.fromEntries(Object.entries(drafts).filter(([item]) => !saving.includes(item))))
+    for (const item of saving) delete baseline.current[item]
+    setPast([])
+    setFuture([])
+    setSaving(null)
+    setStatus('Site updated.')
+  }
+  const openPreview = () => {
+    const token = String(Date.now())
+    sessionStorage.setItem('hx26-preview-' + token, JSON.stringify(site))
+    window.open(href(routePath(front(currentPage), { preview: token })), '_blank')
+    setPreview(false)
+  }
+  const dragEvents = {
+    onPointerDown(event) {
+      if (event.button !== 0 || !event.target.closest('.hx26-block-label')) return
+      const row = event.target.closest('[data-block-id]')
+      drag.current = { id: row.dataset.blockId, x: event.clientX, y: event.clientY, active: false }
+    },
+    onPointerMove(event) {
+      const origin = drag.current
+      if (!origin || !event.buttons) return
+      if (!origin.active) {
+        if (Math.hypot(event.clientX - origin.x, event.clientY - origin.y) < 7) return
+        origin.active = true
+        event.currentTarget.setPointerCapture(event.pointerId)
+        onSelect(origin.id)
+      }
+      const row = document.elementFromPoint(event.clientX, event.clientY)?.closest('[data-block-id]')
+      const target = row?.dataset.blockId
+      if (!target || target === origin.id || !siblingList(entity.blocks, origin.id)?.some((item) => item.id === target)) {
+        origin.destination = null
+        setDrop(null)
+        return
+      }
+      const rect = row.getBoundingClientRect()
+      origin.destination = { id: target, after: event.clientY > rect.y + rect.height / 2 }
+      setDrop(origin.destination)
+    },
+    onPointerUp() {
+      const origin = drag.current
+      const destination = origin?.destination
+      if (destination) change(relocate(entity.blocks, origin.id, destination.id, destination.after))
+      drag.current = null
+      setDrop(null)
+    },
+    onPointerCancel() {
+      drag.current = null
+      setDrop(null)
+    },
+  }
+  const selection = { site, selected, onSelect, expanded, setExpanded, onMenu: openMenu, drop }
+  return <div className="hx26-editor">
+    <header className="hx26-toolbar">
+      <div className="hx26-toolbar-left">
+        <SiteLink className="hx26-editor-brand" to={pathFor(kind)} aria-label={'Back to ' + tabs[kind]}>{wordpress}</SiteLink>
+        <IconButton icon={undo} label="Undo" onClick={() => travel(false)} disabled={!past.length} />
+        <IconButton icon={redo} label="Redo" onClick={() => travel(true)} disabled={!future.length} />
+        <IconButton icon={listView} label="Document Overview" aria-pressed={open} onClick={() => setOpen(!open)} />
+      </div>
+      <div className="hx26-toolbar-title">{entity.title} <span>· {kind === 'patterns' ? 'Pattern' : 'Template'}</span></div>
+      <div className="hx26-toolbar-right">
+        <div className="hx26-menu-anchor"><IconButton icon={desktop} label="View" aria-expanded={preview} onClick={() => { setPreview(!preview); setMenu(null) }} />
+          {preview && <div className="hx26-popup hx26-preview-menu" aria-label="Preview options">
+            {['Desktop', 'Tablet', 'Mobile'].map((mode) => <button type="button" key={mode} aria-pressed={device === mode} onClick={() => { setDevice(mode); setPreview(false) }}>{mode}</button>)}
+            <button type="button" onClick={openPreview}>Preview in new tab {external}</button>
+            <SiteLink to={front(currentPage)} target="_blank">View published page {external}</SiteLink>
+          </div>}
+        </div>
+        <button className="hx26-text-button" type="button" aria-pressed={settings} onClick={() => setSettings(!settings)}>Settings</button>
+        <button type="button" className="hx26-primary" onClick={() => setSaving(dirty)} disabled={!dirty.length}>Save</button>
+      </div>
+    </header>
+    <div className="hx26-editor-body">
+      {open && <aside className="hx26-tree" {...dragEvents}><header><strong>List View</strong><IconButton icon={close} label="Close List View" onClick={() => setOpen(false)} /></header>
+        <BlockList {...selection} blocks={entity.blocks} />
+      </aside>}
+      <main className="hx26-preview-canvas">
+        {block && <div className="hx26-selection-bar">
+          {iconFor[block.type]}<span>{titleFor(block, site.patterns)}</span>
+          <IconButton label="Move up" icon={arrowUp} onClick={() => move(-1)} />
+          <IconButton label="Move down" icon={arrowDown} onClick={() => move(1)} />
+          {block.type === 'reference' && <button type="button" className="hx26-text-button hx26-linked" onClick={editOriginal}>Edit original</button>}
+          <IconButton icon={more} label="Block options" onClick={(event) => openMenu(block.id, event.currentTarget.getBoundingClientRect())} />
+        </div>}
+        <div className={'hx26-device hx26-' + device.toLowerCase()}>{kind === 'templates'
+          ? <Exhibition slug={currentPage} site={site} edit={{ selected, onSelect, onEdit: edit }} />
+          : <article className="hx26-pattern-canvas"><Blocks blocks={entity.blocks} site={site} selected={selected} onSelect={onSelect} onEdit={edit} /></article>}</div>
+      </main>
+      {settings && <aside className="hx26-inspector"><header><strong>{block ? 'Block' : (kind === 'templates' ? 'Template' : 'Pattern')}</strong><IconButton icon={close} label="Close Settings" onClick={() => setSettings(false)} /></header>
+        <h3>{block ? titleFor(block, site.patterns) : entity.title}</h3>
+        {block?.type === 'reference' ? <><p>Synced pattern</p><p>Changes to the original apply everywhere this pattern is used.</p><button type="button" className="hx26-text-button" onClick={editOriginal}>Edit original</button></> : <p>{block?.anchor ? 'HTML anchor: ' + block.anchor : entity.description}</p>}
+        {kind === 'templates' && <label>Preview page <select value={currentPage} onChange={(event) => go(routePath(editor, { path: '/templates', postId: id, postType: 'wp_template', canvas: 'edit', previewPage: event.target.value }))}>{pageOptions.map(([slug, page]) => <option key={slug} value={slug}>{page.title}</option>)}</select></label>}
+      </aside>}
+    </div>
+    {menu && block && <><button type="button" className="hx26-scrim" aria-label="Close block options" onClick={() => setMenu(null)} /><div className="hx26-popup hx26-block-menu" aria-label="Block options" style={{ left: menu.x, top: menu.y }}>
+      <button type="button" onClick={() => move(-1)}>Move up</button><button type="button" onClick={() => move(1)}>Move down</button>
+      {block.type === 'reference' && <><button type="button" onClick={editOriginal}>Edit original</button><button type="button" onClick={detach}>Detach</button></>}
+    </div></>}
+    {saving && <div className="hx26-save-scrim"><section className="hx26-save-panel" role="dialog" aria-modal="true" aria-labelledby="hx26-save-title">
+      <header><button type="button" className="hx26-text-button" onClick={() => setSaving(null)}>Cancel</button><button type="button" className="hx26-primary" onClick={storeChanges} disabled={!saving.length}>Save</button></header>
+      <h2 id="hx26-save-title">Are you ready to save?</h2><p>Review the items you want to save.</p>
+      {dirty.map((item) => <label key={item}><input type="checkbox" checked={saving.includes(item)} onChange={(event) => setSaving(event.target.checked ? [...saving, item] : saving.filter((entry) => entry !== item))} />
+        <span><strong>{drafts[item].title}</strong><small>{item.startsWith('templates:') ? 'Template' : 'Synced pattern'}</small></span></label>)}
+    </section></div>}
+    {status && <div className="hx26-feedback" role="status">{status}</div>}
+  </div>
+}
+
+export function SiteEditorRoute() {
+  const store = useStore()
+  return store.state.hx26
+    ? <Editor store={store} />
+    : <main className="neutral">Site Editor unavailable. <SiteLink to={dashboardPath}>Return to Dashboard</SiteLink></main>
+}
