@@ -0,0 +1,118 @@
+import React, { useEffect, useState } from 'react';
+import { Clock, Film, Globe, Lock, Search, Video, X } from 'lucide-react';
+import { Link } from 'react-router-dom';
+import { useData } from '../context/DataContext';
+import { STATUS, dateForInput, displayTime, publishingUpdate, videoStatus } from '../data/publishing';
+import './StudioPage.css';
+
+const DATE_TYPE = { public: 'Published', unlisted: 'Uploaded', private: 'Uploaded',
+  draft: 'Last uploaded', scheduled: 'Publishes', premiere: 'Premieres' };
+
+function VideoEditor({ video, onClose, onSave }) {
+  const [choice, setChoice] = useState(() => videoStatus(video));
+  const [date, setDate] = useState(() => dateForInput(video.premiereAt || video.publishAt));
+  const [error, setError] = useState('');
+  const timed = choice === 'scheduled' || choice === 'premiere';
+  useEffect(() => {
+    function handleKey(event) {
+      if (event.key === 'Escape') onClose();
+    }
+    document.addEventListener('keydown', handleKey);
+    return () => document.removeEventListener('keydown', handleKey);
+  }, [onClose]);
+  function save(event) {
+    event.preventDefault();
+    const update = publishingUpdate(video, choice, date);
+    if (!update) {
+      setError('Choose a future date and time in the channel time zone.');
+      return;
+    }
+    onSave(video.videoId, update);
+    onClose();
+  }
+  return (
+    <div className="studio-scrim" onClick={onClose}>
+      <form role="dialog" aria-modal="true" aria-label="Publishing settings" className="studio-editor" onSubmit={save} onClick={event => event.stopPropagation()}>
+        <div className="studio-editor-heading">
+          <h2>Publishing settings</h2>
+          <button type="button" aria-label="Close publishing settings" onClick={onClose}><X size={20} /></button>
+        </div>
+        <img src={video.thumbnail} alt="" />
+        <h3>{video.title}</h3>
+        <p>{video.description}</p>
+        <label>Visibility<select value={choice} onChange={event => setChoice(event.target.value)}>
+          {Object.entries(STATUS).map(([key, label]) => <option key={key} value={key}>{label}</option>)}
+        </select></label>
+        {timed && <label>Publish on<input type="datetime-local" required value={date} onChange={event => setDate(event.target.value)} />
+          <small>{Intl.DateTimeFormat().resolvedOptions().timeZone.replaceAll('_', ' ')}</small>
+        </label>}
+        {error && <p role="alert">{error}</p>}
+        <div className="studio-editor-actions"><button type="button" onClick={onClose}>Cancel</button><button type="submit">Save</button></div>
+      </form>
+    </div>
+  );
+}
+
+export default function StudioPage() {
+  const { data, updateVideoPublishing, showToast, now } = useData();
+  const [filter, setFilter] = useState('all');
+  const [query, setQuery] = useState('');
+  const [editing, setEditing] = useState(null);
+  const own = data.videos.filter(video => video.channelId === data.user.userId);
+  const visible = own.filter(video =>
+    (filter === 'all' || videoStatus(video, now) === filter) &&
+    `${video.title} ${video.videoId}`.toLowerCase().includes(query.trim().toLowerCase())
+  );
+  const selected = own.find(video => video.videoId === editing);
+  return (
+    <section className="studio-desk">
+      <header className="studio-heading">
+        <div className="studio-channel">
+          <img src={data.user.avatar} alt="" />
+          <div><p>{data.user.displayName} · {data.user.handle}</p><h1>Channel content</h1></div>
+        </div>
+        <Link to="/upload"><Video size={18} /> Upload video</Link>
+      </header>
+      <div className="studio-body">
+        <div className="studio-controls">
+          <label><Search size={18} /><input placeholder="Search your videos" aria-label="Search your videos" value={query} onChange={event => setQuery(event.target.value)} /></label>
+          <label>Visibility<select value={filter} onChange={event => setFilter(event.target.value)}>
+            <option value="all">All visibility</option>
+            {Object.entries(STATUS).map(([key, label]) => <option key={key} value={key}>{label}</option>)}
+          </select></label>
+          <span>{visible.length} videos</span>
+        </div>
+        <div className="studio-table">
+          <table>
+            <thead><tr><th scope="col">Video</th><th scope="col">Visibility</th><th scope="col">Date</th><th scope="col">Views</th><th scope="col">Comments</th><th scope="col">Likes</th></tr></thead>
+            <tbody>{visible.map(video => {
+              const status = videoStatus(video, now);
+              const date = status === 'premiere' ? video.premiereAt :
+                status === 'scheduled' ? video.publishAt : (video.premiereAt || video.publishAt || video.uploadDate);
+              const Icon = status === 'public' ? Globe : ['scheduled', 'premiere'].includes(status) ? Clock : status === 'draft' ? Film : Lock;
+              return (
+                <tr key={video.videoId}>
+                  <td><div className="studio-video">
+                    <img src={video.thumbnail} alt="" /><div><button onClick={() => setEditing(video.videoId)}>{video.title}</button>
+                    <p>{video.description}</p>
+                    <Link to={`/watch/${video.videoId}`}>Owner preview</Link><Link to={`/watch/${video.videoId}?audience=guest`}>Viewer preview</Link></div></div>
+                  </td>
+                  <td><button className={`studio-status studio-${status}`} onClick={() => setEditing(video.videoId)} aria-label={`Edit visibility of ${video.title}`}><Icon size={15} />{STATUS[status]}</button></td>
+                  <td>{displayTime(date)}<small>{DATE_TYPE[status]}</small></td>
+                  {status === 'draft'
+                    ? <td colSpan={3}><button onClick={() => setEditing(video.videoId)}>Edit draft</button></td>
+                    : <><td>{video.viewCount.toLocaleString('en-US')}</td><td>{(data.comments[video.videoId] || []).length}</td><td>{video.likeCount.toLocaleString('en-US')}</td></>}
+                </tr>
+              );
+            })}</tbody>
+          </table>
+          {!visible.length && <p className="studio-empty">No videos match these filters.</p>}
+        </div>
+      </div>
+      {selected && <VideoEditor key={selected.videoId} video={selected} onClose={() => setEditing(null)} onSave={(id, update) => {
+        updateVideoPublishing(id, update);
+        showToast('Publishing settings updated');
+      }} />}
+    </section>
+  );
+}
