diff --git a/src/data/publishing.js b/src/data/publishing.js
new file mode 100644
index 0000000..33eb57d
--- /dev/null
+++ b/src/data/publishing.js
@@ -0,0 +1,57 @@
+export const STATUS = {
+  public: 'Public',
+  scheduled: 'Scheduled',
+  unlisted: 'Unlisted',
+  private: 'Private',
+  premiere: 'Premiere',
+  draft: 'Draft',
+};
+
+export function videoStatus(video, now = Date.now()) {
+  if (video.uploadStatus === 'draft') return 'draft';
+  if (video.visibility === 'private') return 'private';
+  if (video.isPremiere && Date.parse(video.premiereAt) > now) return 'premiere';
+  if (Date.parse(video.publishAt) > now) return 'scheduled';
+  return video.visibility === 'unlisted' ? 'unlisted' : 'public';
+}
+
+export function canWatch(video, ownsVideo, now = Date.now()) {
+  if (!video) return false;
+  return ownsVideo || ['public', 'unlisted', 'premiere'].includes(videoStatus(video, now));
+}
+
+export function publishedDate(video, now = Date.now()) {
+  const timed = video.isPremiere ? video.premiereAt : video.publishAt;
+  return Date.parse(timed) <= now ? timed : video.uploadDate;
+}
+
+export function displayTime(date) {
+  if (!date || !Number.isFinite(Date.parse(date))) return '—';
+  return new Intl.DateTimeFormat('en-US', {
+    month: 'short', day: 'numeric', year: 'numeric',
+    hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
+  }).format(new Date(date));
+}
+
+export function dateForInput(date) {
+  if (!date || !Number.isFinite(Date.parse(date))) return '';
+  const instant = new Date(date);
+  return new Date(instant.getTime() - instant.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
+}
+
+export function publishingUpdate(video, choice, time, now = Date.now()) {
+  const requested = new Date(time);
+  const timed = choice === 'scheduled' || choice === 'premiere';
+  if (!(choice in STATUS)) return null;
+  if (timed && (!Number.isFinite(requested.getTime()) || requested.getTime() <= now)) return null;
+  const wasPublic = videoStatus(video, now) === 'public';
+  const when = timed ? requested.toISOString() : null;
+  return {
+    visibility: timed || choice === 'draft' ? (timed ? 'public' : 'private') : choice,
+    uploadStatus: choice === 'draft' ? 'draft' : 'processed',
+    publishAt: choice === 'scheduled' ? when : null,
+    isPremiere: choice === 'premiere',
+    premiereAt: choice === 'premiere' ? when : null,
+    uploadDate: choice === 'public' && !wasPublic ? new Date(now).toISOString() : video.uploadDate,
+  };
+}
