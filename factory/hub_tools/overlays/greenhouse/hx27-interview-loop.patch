diff --git a/src/hx27/Editor.jsx b/src/hx27/Editor.jsx
new file mode 100644
index 0000000..aed4ac1
--- /dev/null
+++ b/src/hx27/Editor.jsx
@@ -0,0 +1,202 @@
+import { useEffect, useRef, useState } from 'react';
+import { Calendar, ChevronDown, ChevronLeft, ChevronRight, MoreHorizontal, X } from 'lucide-react';
+import { dateLabel, dateOf, nameOf, kitOf, timeOf, conflicts, calendarRows } from './model';
+
+function StaffChooser({ state, staff, change }) {
+  const [opened, setOpened] = useState(false);
+  const [filter, setFilter] = useState('');
+  const [pool, setPool] = useState('All interviewers');
+  const people = state.hx27.staff.filter(row =>
+    (pool === 'All interviewers' || row.role === pool) &&
+    [nameOf(state, row.id), row.competency, state.users.find(user => user.id === row.id)?.department]
+      .some(value => value?.toLowerCase().includes(filter.toLowerCase())));
+  return <div className="gh27-field">
+    <span>Interviewers</span>
+    <button type="button" className="gh27-select" aria-expanded={opened} onClick={() => setOpened(!opened)}>
+      {staff ? nameOf(state, staff) : 'Choose interviewer'} <ChevronDown size={15} />
+    </button>
+    {opened && <div className="gh27-options">
+      <label>Filter interviewers
+        <select aria-label="Filter interviewers" value={pool} onChange={event => setPool(event.target.value)}>
+          {['All interviewers', 'Lead', 'Observer', 'Shadow'].map(value => <option key={value}>{value}</option>)}
+        </select>
+      </label>
+      <input aria-label="Search interviewers" placeholder="Search name or competency" value={filter} onChange={event => setFilter(event.target.value)} />
+      <div className="gh27-results">
+        {people.map(row => <button key={row.id} type="button" onClick={() => { change(row.id); setOpened(false); }}>
+          <strong>{nameOf(state, row.id)} · {state.users.find(user => user.id === row.id)?.department}</strong>
+          <small>{row.competency} · {row.role} {row.certified ? '· Current certification' : ''}</small>
+        </button>)}
+        {!people.length && <p>No matching interviewers</p>}
+      </div>
+    </div>}
+  </div>;
+}
+
+function KitChooser({ state, kit, change }) {
+  return <label className="gh27-field">Interview kit
+    <select aria-label="Interview kit" value={kit} onChange={event => change(event.target.value)}>
+      <option value="">Choose a kit</option>
+      {['Approved', 'Technical', 'Archived'].map(group => <optgroup label={group} key={group}>
+        {state.hx27.kits.filter(row => row.group === group).map(row => <option key={row.id} value={row.id} disabled={group === 'Archived'}>{row.name}</option>)}
+      </optgroup>)}
+    </select>
+  </label>;
+}
+
+function increment(date, amount) {
+  const parsed = new Date(`${date}T12:00:00Z`);
+  parsed.setUTCDate(parsed.getUTCDate() + amount);
+  return parsed.toISOString().slice(0, 10);
+}
+function slot(hour, minute = 0) {
+  return `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
+}
+function add45(time) {
+  const total = Number(time.slice(0, 2)) * 60 + Number(time.slice(3)) + 45;
+  return slot(Math.floor(total / 60), total % 60);
+}
+
+function CalendarGrid({ state, interview, draft, patch }) {
+  const grid = useRef(null);
+  const busy = calendarRows(state, interview, draft.date, draft.staff);
+  const windows = state.hx27.availability[interview.applicationId]?.filter(row => row.date === draft.date) || [];
+  const intervals = Array.from({ length: 32 }, (_, i) => slot(9 + Math.floor(i / 4), (i % 4) * 15));
+  useEffect(() => {
+    const first = windows[0]?.start || draft.start;
+    const index = intervals.indexOf(first);
+    grid.current.scrollTop = Math.max(0, index - 4) * 25;
+  }, [draft.date]);
+  return <section className="gh27-cal" aria-label="Interviewer calendar">
+    <div className="gh27-calheader">
+      <button aria-label="Previous day" onClick={() => patch({ date: increment(draft.date, -1) })}><ChevronLeft size={20} /></button>
+      <h2>{dateLabel(draft.date)}</h2>
+      <button aria-label="Next day" onClick={() => patch({ date: increment(draft.date, 1) })}><ChevronRight size={20} /></button>
+      <small>Eastern Time</small>
+    </div>
+    <div className="gh27-calrows" ref={grid}>
+      <div className="gh27-calrow gh27-calhead"><span>Time</span><span>Candidate availability</span><span>{nameOf(state, draft.staff)}</span></div>
+      {intervals.map(time => {
+        const available = windows.find(row => row.start <= time && time < row.end);
+        const busyRow = busy.find(row => row.start <= time && time < row.end);
+        const selected = draft.start <= time && time < draft.end;
+        return <div className="gh27-calrow" key={time}>
+          <span>{time}</span>
+          <button className={available ? 'available' : ''} aria-label={`Start at ${time}`} onClick={() => patch({ start: time, end: add45(time) })}>
+            {available?.start === time ? `Available · ${available.start}–${available.end}` : ''}
+          </button>
+          <span className={busyRow ? 'busy' : selected ? 'selected' : ''}>
+            {busyRow?.start === time ? busyRow.label : selected && draft.start === time ? interview.interviewType : ''}
+          </span>
+        </div>;
+      })}
+    </div>
+  </section>;
+}
+
+export default function Editor({ state, dispatch, candidate, stage, interview, assigning, close, report }) {
+  const dialog = useRef(null);
+  const [preview, setPreview] = useState(false);
+  const [draft, setDraft] = useState(() => ({
+    date: dateOf(interview.scheduledAt), start: timeOf(interview.scheduledAt), end: timeOf(interview.endedAt),
+    staff: assigning ? '' : interview.interviewerIds[0], kit: assigning ? '' : interview.scorecardKitId ?? '',
+    revision: interview.revision, mail: false,
+  }));
+  useEffect(() => { dialog.current.showModal(); }, []);
+  const patch = values => setDraft(old => ({ ...old, ...values }));
+  const blocked = assigning ? [] : conflicts(state, interview, draft);
+  if (assigning && interview.interviewerIds.includes(draft.staff)) blocked.push('This interviewer is already on the scheduled interview.');
+  if (assigning && state.scorecards.some(card => card.interviewId === interview.id && card.interviewerId === draft.staff)) {
+    blocked.push('This interviewer already has a scorecard for this interview.');
+  }
+  const ready = Boolean(draft.staff && draft.kit) && blocked.length === 0;
+  const title = assigning ? 'Assign scorecard' : `Reschedule ${stage.name} interviews`;
+  const commit = () => {
+    if (!ready) return;
+    dispatch({
+      type: assigning ? 'HX27_ASSIGN_SCORECARD' : 'HX27_RESCHEDULE',
+      payload: { interviewId: interview.id, draft },
+    });
+    report(assigning ? 'Scorecard assigned' : 'Interview updated');
+    close();
+  };
+  return <dialog ref={dialog} className={`gh27-dialog ${assigning ? 'compact' : ''}`} aria-label={title} onCancel={close}>
+    <header className="gh27-dialoghead"><span>{title}</span><button aria-label="Close" onClick={close}><X size={21} /></button></header>
+    {!preview && <>
+      <div className="gh27-toolbar">
+        <strong>{candidate.name}</strong>
+        {!assigning && <button className="gh27-primary" disabled={!ready} onClick={() => setPreview(true)}>Schedule and continue <ChevronRight size={16} /></button>}
+      </div>
+      <div className={assigning ? '' : 'gh27-columns'}>
+        <section className="gh27-settings">
+          <h2>{assigning ? interview.interviewType : 'Interview settings'}</h2>
+          {!assigning && <p><Calendar size={15} /> {interview.interviewType} ({interview.durationMinutes} min)</p>}
+          {assigning && <p>Scorecard only</p>}
+          <StaffChooser state={state} staff={draft.staff} change={staff => patch({ staff })} />
+          <KitChooser state={state} kit={draft.kit} change={kit => patch({ kit })} />
+          {!assigning && <>
+            <label className="gh27-field">Date
+              <select aria-label="Date" value={draft.date} onChange={event => patch({ date: event.target.value })}>
+                {[...new Set([dateOf(interview.scheduledAt), ...(state.hx27.availability[interview.applicationId] || []).map(row => row.date), draft.date])].sort().map(date =>
+                  <option key={date} value={date}>{dateLabel(date)}</option>)}
+              </select>
+            </label>
+            <div className="gh27-times">
+              <label className="gh27-field">Start time
+                <select aria-label="Start time" value={draft.start} onChange={event => patch({ start: event.target.value, end: add45(event.target.value) })}>
+                  {Array.from({ length: 32 }, (_, i) => slot(9 + Math.floor(i / 4), (i % 4) * 15)).map(time => <option key={time}>{time}</option>)}
+                </select>
+              </label>
+              <label className="gh27-field">End time
+                <select aria-label="End time" value={draft.end} onChange={event => patch({ end: event.target.value })}>
+                  {Array.from({ length: 36 }, (_, i) => slot(9 + Math.floor(i / 4), (i % 4) * 15)).map(time => <option key={time}>{time}</option>)}
+                </select>
+              </label>
+            </div>
+          </>}
+          {!!blocked.length && <div role="alert" className="gh27-warning"><strong>{assigning ? 'Assignment conflict' : 'Scheduling conflict'}</strong>{blocked.map(reason => <div key={reason}>{reason}</div>)}</div>}
+          {assigning && <div className="gh27-dialogactions"><button onClick={close}>Cancel</button><button className="gh27-primary" disabled={!ready} onClick={commit}>Save</button></div>}
+        </section>
+        {!assigning && <CalendarGrid state={state} interview={interview} draft={draft} patch={patch} />}
+      </div>
+    </>}
+    {preview && <>
+      <div className="gh27-preview">
+        <h2>Interview update</h2>
+        <div className="gh27-previewcard">
+          <h3>{interview.interviewType}</h3>
+          <dl>
+            <dt>Candidate</dt><dd>{candidate.name} · {candidate.email}</dd>
+            <dt>When</dt><dd>{dateLabel(draft.date)} · {draft.start}–{draft.end} ET</dd>
+            <dt>Interviewer</dt><dd>{nameOf(state, draft.staff)}</dd>
+            <dt>Interview kit</dt><dd>{kitOf(state, draft.kit)}</dd>
+            <dt>Location</dt><dd>{interview.location}</dd>
+          </dl>
+          <label><input type="checkbox" checked={draft.mail} onChange={event => patch({ mail: event.target.checked })} /> Send an email update to all interviewers</label>
+        </div>
+      </div>
+      <footer className="gh27-dialogactions"><button onClick={() => setPreview(false)}>Back</button><button className="gh27-primary" onClick={commit}>Update interviews</button></footer>
+    </>}
+  </dialog>;
+}
+
+export function InterviewMenu({ label, children }) {
+  const [open, setOpen] = useState(false);
+  const menu = useRef(null);
+  const [opensUp, setOpensUp] = useState(false);
+  useEffect(() => {
+    if (!open) return;
+    const closeOutside = event => { if (!menu.current?.contains(event.target)) setOpen(false); };
+    const escape = event => { if (event.key === 'Escape') setOpen(false); };
+    document.addEventListener('mousedown', closeOutside);
+    document.addEventListener('keydown', escape);
+    return () => {
+      document.removeEventListener('mousedown', closeOutside);
+      document.removeEventListener('keydown', escape);
+    };
+  }, [open]);
+  return <div className="gh27-menu" ref={menu}>
+    <button aria-label={label} aria-expanded={open} onClick={() => { setOpensUp(window.innerHeight - menu.current.getBoundingClientRect().bottom < 90); setOpen(!open); }}><MoreHorizontal size={20} /></button>
+    {open && <div className={opensUp ? "gh27-pop opens-up" : "gh27-pop"} onClick={() => setOpen(false)}>{children}</div>}
+  </div>;
+}
