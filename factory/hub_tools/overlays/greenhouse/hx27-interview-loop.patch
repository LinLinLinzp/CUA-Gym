@@ -0,0 +1,91 @@
+const stamp = (date, time) => `${date}T${time}:00-05:00`;
+export const duration = (start, end) => {
+  const minutes = time => Number(time.slice(0, 2)) * 60 + Number(time.slice(3));
+  return minutes(end) - minutes(start);
+};
+export const timeOf = stamp => stamp?.slice(11, 16) || '';
+export const dateOf = stamp => stamp?.slice(0, 10) || '';
+export const nameOf = (state, id) => state.users.find(user => user.id === id)?.name || 'Unassigned';
+export const kitOf = (state, id) => state.hx27.kits.find(kit => kit.id === id)?.name || 'No interview kit';
+export const dateLabel = date => new Intl.DateTimeFormat('en-US', {
+  weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC',
+}).format(new Date(`${date}T12:00:00Z`));
+
+function busyAt(state, interview, date, staff) {
+  const sameDay = state.interviews.filter(row => row.id !== interview.id && row.status === 'scheduled' && dateOf(row.scheduledAt) === date);
+  return [
+    ...state.hx27.busy.filter(row => row.id === staff && row.date === date),
+    ...sameDay.filter(row => row.applicationId === interview.applicationId || row.interviewerIds.includes(staff)).map(row => ({
+      start: timeOf(row.scheduledAt), end: timeOf(row.endedAt), label: row.interviewType,
+    })),
+  ];
+}
+
+export function conflicts(state, interview, draft) {
+  const { date, start, end, staff } = draft;
+  if (duration(start, end) !== interview.durationMinutes) return [`Use the full ${interview.durationMinutes} minutes.`];
+  const windows = state.hx27.availability[interview.applicationId];
+  const blocked = busyAt(state, interview, date, staff).filter(row => start < row.end && end > row.start);
+  const messages = blocked.map(row => `${row.label} · ${row.start}–${row.end}`);
+  if (windows && !windows.some(row => row.date === date && start >= row.start && end <= row.end)) {
+    messages.unshift('Outside the latest candidate availability.');
+  }
+  return messages;
+}
+
+export function calendarRows(state, interview, date, staff) {
+  return busyAt(state, interview, date, staff);
+}
+
+export function repairReducer(state, action) {
+  const { interviewId, draft, eventId } = action.payload;
+  if (action.type === 'HX27_REVIEW_EVENT') {
+    if (!state.activityFeed.some(event => event.id === eventId) || state.hx27.viewed.includes(eventId)) return state;
+    return { ...state, hx27: { ...state.hx27, viewed: [...state.hx27.viewed, eventId] } };
+  }
+  const interview = state.interviews.find(row => row.id === interviewId);
+  if (!interview || interview.revision !== draft.revision || interview.status !== 'scheduled') return state;
+  const application = state.applications.find(row => row.id === interview.applicationId);
+  const kit = state.hx27.kits.find(row => row.id === draft.kit);
+  if (!kit || kit.group === 'Archived' || !state.hx27.staff.some(row => row.id === draft.staff)) return state;
+  const assigning = action.type === 'HX27_ASSIGN_SCORECARD';
+  const id = assigning ? `${interviewId}:scorecard:${draft.staff}` : `${interviewId}:${interview.revision + 1}`;
+  if (state.activityFeed.some(event => event.id === id)) return state;
+  const card = {
+    id, applicationId: application.id, stageId: interview.stageId, interviewId,
+    interviewerId: draft.staff, kitId: draft.kit, status: 'pending',
+    assignmentMode: assigning ? 'scorecard_only' : 'scheduled',
+  };
+  const entry = {
+    id, candidateId: application.candidateId, applicationId: application.id, interviewId,
+    revision: assigning ? interview.revision : interview.revision + 1,
+    type: assigning ? 'scorecard_assigned' : 'interview_rescheduled',
+    title: assigning ? 'Scorecard assigned' : 'Interview rescheduled',
+    description: assigning
+      ? `${interview.interviewType} · Scorecard only · ${nameOf(state, draft.staff)} · ${kit.name}`
+      : `${interview.interviewType} · ${dateLabel(draft.date)}, ${draft.start}–${draft.end} ET · ${nameOf(state, draft.staff)} · ${kit.name}`,
+    createdAt: new Date().toISOString(),
+  };
+  if (assigning) {
+    if (interview.interviewerIds.includes(draft.staff)) return state;
+    return { ...state, scorecards: [...state.scorecards, card], activityFeed: [entry, ...state.activityFeed] };
+  }
+  if (conflicts(state, interview, draft).length) return state;
+  const scheduledAt = stamp(draft.date, draft.start);
+  const endedAt = stamp(draft.date, draft.end);
+  const changed = {
+    ...interview, scheduledAt, endedAt, startTime: scheduledAt, endTime: endedAt,
+    interviewerIds: [draft.staff], scorecardKitId: draft.kit, revision: interview.revision + 1,
+    sendEmailUpdate: draft.mail,
+  };
+  const scheduledCard = row => row.interviewId === interviewId && row.assignmentMode === 'scheduled' && row.status === 'pending';
+  const scorecards = state.scorecards.some(scheduledCard)
+    ? state.scorecards.map(row => scheduledCard(row) ? { ...row, interviewerId: draft.staff, kitId: draft.kit } : row)
+    : [...state.scorecards, card];
+  const activityFeed = [entry, ...state.activityFeed];
+  if (draft.mail) activityFeed.unshift({
+    ...entry, id: `${id}:email`, type: 'email_sent', title: 'Interview update email logged',
+    description: `Local simulation · ${nameOf(state, draft.staff)}`,
+  });
+  return { ...state, interviews: state.interviews.map(row => row.id === interviewId ? changed : row), scorecards, activityFeed };
+}
