+import { useState } from 'react';
+import { Link, useParams } from 'react-router-dom';
+import { Bell, Briefcase, Calendar, ChevronRight, ClipboardList, MessageSquare, User } from 'lucide-react';
+import { useAppContext } from '../context/AppContext';
+import Editor, { InterviewMenu } from './Editor';
+import { dateLabel, dateOf, nameOf, kitOf, timeOf } from './model';
+import './profile.css';
+
+export default function Profile() {
+  const { candidateId } = useParams();
+  return <CandidatePane key={candidateId} candidateId={candidateId} />;
+}
+
+function CandidatePane({ candidateId }) {
+  const { state, dispatch } = useAppContext();
+  const candidate = state.candidates.find(row => row.id === candidateId);
+  const applications = state.applications.filter(row => row.candidateId === candidateId);
+  const [active, setActive] = useState(applications[0]?.id);
+  const application = applications.find(row => row.id === active);
+  const [tab, setTab] = useState('Stages');
+  const [panel, setPanel] = useState('Candidate');
+  const [editor, setEditor] = useState(null);
+  const [notice, setNotice] = useState('');
+  const [kind, setKind] = useState('all');
+  const [query, setQuery] = useState('');
+  const suffix = window.location.search;
+  if (!candidate || !application) return <p className="gh27-inset">Candidate application unavailable.</p>;
+  const job = state.jobs.find(row => row.id === application.jobId);
+  const stages = state.jobStages.filter(row => row.jobId === job.id).sort((a, b) => a.orderIndex - b.orderIndex);
+  const feedback = state.scorecards.filter(row => row.applicationId === active);
+  const activity = state.activityFeed.filter(row => row.applicationId === active)
+    .filter(row => kind === 'all' || (kind === 'activity' ? !['note_added', 'scorecard_submitted'].includes(row.type) : row.type === kind))
+    .filter(row => !query || `${row.title} ${row.description}`.toLowerCase().includes(query.toLowerCase()))
+    .sort((a, b) => b.createdAt.localeCompare(a.createdAt));
+  const selectJob = app => { setActive(app.id); setTab('Stages'); setNotice(''); setKind('all'); setQuery(''); };
+  return <div className="gh27">
+    <div className="gh27-crumb">
+      <Link to={`/candidates${suffix}`}>Candidates</Link><ChevronRight size={14} />
+      <span>{job.title} ({job.requisitionId})</span><ChevronRight size={14} /><span>{candidate.name}</span>
+    </div>
+    <header className="gh27-profilehead">
+      <h1>{candidate.name}</h1>
+      <div><span className="gh27-linktext">{candidate.email}</span> · <span>{candidate.timezone}</span></div>
+      <div className="gh27-tag">{candidate.source === 'referral' ? 'Referral' : 'Applied'}</div>
+    </header>
+    <div className="gh27-workspace">
+      <div className="gh27-onjob">
+        <div className="gh27-jobbar">
+          <label>On job
+            <select value={active} onChange={event => selectJob(applications.find(app => app.id === event.target.value))}>
+              {applications.map(app => {
+                const role = state.jobs.find(row => row.id === app.jobId);
+                return <option value={app.id} key={app.id}>{role.title} ({role.requisitionId})</option>;
+              })}
+            </select>
+          </label>
+          <span className="gh27-tag">Active</span>
+        </div>
+        {notice && <div className="gh27-success" role="status">{notice}</div>}
+        <div className="gh27-main">
+          <nav aria-label="On job">
+            {['Stages', 'Scorecards', 'Activity feed'].map(item => <button key={item} aria-pressed={tab === item} onClick={() => setTab(item)}>{item}</button>)}
+          </nav>
+          <section className="gh27-content">
+            {tab === 'Stages' && stages.map(stage => <details key={stage.id} className="gh27-stage">
+              <summary><strong>{stage.orderIndex + 1}. {stage.name}</strong> {stage.id === application.currentStageId && <span className="gh27-current">Current stage</span>}</summary>
+              {stage.id === application.currentStageId && <details className="gh27-availability">
+                <summary>Availability</summary>
+                <div className="gh27-availabilitybox">
+                  <div><strong>Suggested times</strong><p>No suggested times</p></div>
+                  <div><strong>Candidate availability · Eastern Time</strong>
+                    {(state.hx27.availability[active] || []).map(window => <div key={window.date + window.start}>{dateLabel(window.date)} · {window.start}–{window.end}</div>)}
+                    {!state.hx27.availability[active] && <p>Awaiting response</p>}
+                  </div>
+                </div>
+              </details>}
+              <section className="gh27-interviews">
+                <h3>Interviews</h3>
+                {state.interviews.filter(row => row.applicationId === active && row.stageId === stage.id).map(interview => <div key={interview.id} className="gh27-interview">
+                  <Calendar size={18} />
+                  <div>
+                    <strong>{interview.interviewType}</strong>
+                    <div>{dateLabel(dateOf(interview.scheduledAt))} · {timeOf(interview.scheduledAt)}–{timeOf(interview.endedAt)} ET</div>
+                    <div>{interview.interviewerIds.map(id => nameOf(state, id)).join(', ')} · {kitOf(state, interview.scorecardKitId)}</div>
+                    {feedback.filter(row => row.interviewId === interview.id && row.assignmentMode === 'scorecard_only').map(card =>
+                      <div className="gh27-scoremini" key={card.id}>Scorecard only · {nameOf(state, card.interviewerId)} · {kitOf(state, card.kitId)}</div>)}
+                  </div>
+                  <span className="gh27-tag">{interview.status === 'completed' ? 'Completed' : 'Scheduled'}</span>
+                  {interview.status === 'scheduled' && <InterviewMenu label={`Actions for ${interview.interviewType}`}>
+                    <button onClick={() => setEditor({ stage, interview, assigning: false })}>Reschedule interview</button>
+                    <button onClick={() => setEditor({ stage, interview, assigning: true })}>Assign scorecard</button>
+                  </InterviewMenu>}
+                </div>)}
+                {!state.interviews.some(row => row.applicationId === active && row.stageId === stage.id) && <p>No interviews scheduled</p>}
+              </section>
+            </details>)}
+            {tab === 'Scorecards' && <div className="gh27-feedback">
+              <h2>Scorecards</h2>
+              {feedback.map(card => {
+                const interview = state.interviews.find(row => row.id === card.interviewId);
+                return <details key={card.id} className="gh27-event">
+                  <summary><strong>{interview?.interviewType}</strong><span>{nameOf(state, card.interviewerId)} · {card.status === 'submitted' ? 'Submitted' : 'Pending'}</span></summary>
+                  <div>{card.assignmentMode === 'scorecard_only' ? 'Scorecard only · ' : ''}{card.kitId && kitOf(state, card.kitId)}</div>
+                  {card.keyTakeaways && <p>{card.keyTakeaways}</p>}
+                </details>;
+              })}
+            </div>}
+            {tab === 'Activity feed' && <>
+              <div className="gh27-filter">
+                <label>Filter by activity type
+                  <select value={kind} onChange={event => setKind(event.target.value)}>
+                    <option value="all">All activity</option><option value="activity">Activity</option>
+                    <option value="note_added">Notes</option><option value="scorecard_submitted">Scorecards</option>
+                  </select>
+                </label>
+                <label>Search activity<input value={query} onChange={event => setQuery(event.target.value)} placeholder="Search activity" /></label>
+              </div>
+              {activity.map(event => <details className="gh27-event" key={event.id} onToggle={e => {
+                if (e.currentTarget.open && ['interview_rescheduled', 'scorecard_assigned'].includes(event.type)) {
+                  dispatch({ type: 'HX27_REVIEW_EVENT', payload: { eventId: event.id } });
+                }
+              }}>
+                <summary><strong>{event.title}</strong><span>{dateLabel(dateOf(event.createdAt))}</span></summary>
+                <p>{event.description}</p>
+              </details>)}
+              {!activity.length && <p>No activity matches your filters</p>}
+            </>}
+          </section>
+        </div>
+      </div>
+      <aside>
+        <div className="gh27-sidebody">
+          <h2>{panel === 'Candidate' ? `${candidate.firstName}'s details` : panel}</h2>
+          {panel === 'Candidate' && <dl>
+            <dt>Name</dt><dd>{candidate.name}</dd><dt>Current job title &amp; company</dt><dd>{candidate.currentTitle} @ {candidate.currentCompany}</dd>
+            <dt>Email address</dt><dd>{candidate.email}</dd><dt>Timezone</dt><dd>{candidate.timezone}</dd>
+          </dl>}
+          {panel === 'Application' && <dl><dt>Requisition</dt><dd>{job.requisitionId}</dd><dt>Applied</dt><dd>{application.appliedAt}</dd><dt>Recruiter</dt><dd>{nameOf(state, application.recruiterId)}</dd></dl>}
+          {panel === 'All jobs' && applications.map(app => {
+            const role = state.jobs.find(row => row.id === app.jobId);
+            return <button key={app.id} className="gh27-joblink" onClick={() => selectJob(app)}>{role.title} ({role.requisitionId})</button>;
+          })}
+          {panel === 'Notes' && state.notes.filter(note => note.applicationId === active).map(note => <details className="gh27-event" key={note.id}><summary>{note.title}</summary><p>{note.body}</p></details>)}
+          {panel === 'Alerts' && <p>{state.notifications.filter(item => item.link === `/candidates/${candidate.id}` && !item.isRead).length} unread</p>}
+        </div>
+        <nav aria-label="Candidate details">
+          {[['Candidate', User], ['Application', ClipboardList], ['All jobs', Briefcase], ['Notes', MessageSquare], ['Alerts', Bell]].map(([label, Icon]) =>
+            <button key={label} aria-pressed={panel === label} onClick={() => setPanel(label)}><Icon size={19} />{label}</button>)}
+        </nav>
+      </aside>
+    </div>
+    {editor && <Editor state={state} dispatch={dispatch} candidate={candidate} {...editor} close={() => setEditor(null)} report={setNotice} />}
+  </div>;
+}
