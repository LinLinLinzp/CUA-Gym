+import React, { useEffect, useState } from 'react';
+
+export default function DocumentPage({ document }) {
+  const source = document.fileUrl || '';
+  const pdf = source.startsWith('data:application/pdf');
+  const [preview, setPreview] = useState('');
+  useEffect(() => {
+    if (!pdf) return undefined;
+    let closed = false;
+    let url;
+    setPreview('');
+    fetch(source).then(response => response.blob()).then(blob => {
+      if (closed) return;
+      url = URL.createObjectURL(blob);
+      setPreview(url);
+    }).catch(() => {});
+    return () => {
+      closed = true;
+      if (url) URL.revokeObjectURL(url);
+    };
+  }, [source, pdf]);
+
+  if (pdf) {
+    return preview
+      ? <iframe title={document.name} src={preview + '#toolbar=0&navpanes=0&view=FitH'}
+          className="w-full h-[1100px] border-0 pointer-events-none" />
+      : <div className="p-6 text-sm text-gray-500">Loading document preview…</div>;
+  }
+  return <img src={source} alt={document.name}
+    className="w-full h-auto pointer-events-none select-none"
+    style={{ minHeight: '1100px', objectFit: 'contain', background: '#fff' }} />;
+}
