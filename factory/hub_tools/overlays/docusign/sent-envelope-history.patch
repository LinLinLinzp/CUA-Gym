@@ -0,0 +1,63 @@
+// Preserve the issued packet independently of later recipient corrections.
+export const canVoid = envelope => ['sent', 'delivered', 'signed'].includes(envelope.status);
+
+export const canCorrect = envelope => ['sent', 'delivered'].includes(envelope.status);
+
+function select(updates, keys) {
+  return Object.fromEntries(keys.filter(key => Object.hasOwn(updates, key)).map(key => [key, updates[key]]));
+}
+
+export function updateDraft(envelope, updates) {
+  if (envelope.status !== 'draft' || envelope.sentSnapshot) return envelope;
+  return { ...envelope, ...select(updates, ['subject', 'message', 'documents', 'recipients', 'fields']) };
+}
+
+const recipientPacket = ({ id, name, email, role, routingOrder }) => ({ id, name, email, role, routingOrder });
+
+export function issue(envelope, updates, now, eventId, actor) {
+  if (envelope.status !== 'draft' || envelope.sentSnapshot) return envelope;
+  const draft = updateDraft(envelope, updates);
+  if (!draft.subject.trim() || !draft.documents.length ||
+      !draft.recipients.some(recipient => recipient.role === 'signer')) return envelope;
+  const sentSnapshot = {
+    sentAt: now,
+    subject: draft.subject,
+    message: draft.message,
+    documents: draft.documents.map(doc => select(doc, ['id', 'name', 'fileSize', 'sha256', 'storedName', 'downloadUrl'])),
+    recipients: draft.recipients.map(recipientPacket),
+    fields: draft.fields.map(field => select(field, ['id', 'documentId', 'recipientId', 'type', 'required', 'x', 'y'])),
+  };
+  return {
+    ...draft, status: 'sent', sentAt: now, lastActivityAt: now, sentSnapshot,
+    expiresAt: draft.expiresAt || new Date(Date.parse(now) + 120 * 86400000).toISOString(),
+    recipients: draft.recipients.map(rec => ({ ...rec, status: rec.status === 'created' ? 'sent' : rec.status })),
+    history: [...draft.history, {
+      id: eventId, timestamp: now, action: 'sent', actorName: actor.name, actorEmail: actor.email,
+      details: 'Envelope sent to ' + draft.recipients.length + ' recipient(s)', snapshot: sentSnapshot,
+    }],
+  };
+}
+
+export function voidIssued(envelope, reason, now, eventId, actor) {
+  if (!canVoid(envelope) || !reason.trim()) return envelope;
+  return {
+    ...envelope, status: 'voided', voidedAt: now, lastActivityAt: now, voidReason: reason.trim(),
+    history: [...envelope.history, {
+      id: eventId, timestamp: now, action: 'voided', actorName: actor.name, actorEmail: actor.email,
+      details: 'Envelope voided: ' + reason.trim(),
+    }],
+  };
+}
+
+export function correctRecipients(envelope, recipients, now, eventId, actor) {
+  if (!canCorrect(envelope) || !Array.isArray(recipients)) return envelope;
+  const before = envelope.recipients.map(recipientPacket);
+  const after = recipients.map(recipientPacket);
+  return {
+    ...envelope, recipients, lastActivityAt: now,
+    history: [...envelope.history, {
+      id: eventId, timestamp: now, action: 'corrected', actorName: actor.name, actorEmail: actor.email,
+      details: 'Envelope corrected - recipients updated', before, after,
+    }],
+  };
+}
