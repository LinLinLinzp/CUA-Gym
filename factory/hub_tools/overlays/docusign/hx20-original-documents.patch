+import {Download,X,Check,Copy,FileText} from 'lucide-react';
+import {PDFDocument} from 'pdf-lib';
+function bytes(url){return Uint8Array.from(atob(url.split(',')[1]),c=>c.charCodeAt(0))}
+function save(name,content){const url=URL.createObjectURL(new Blob([content],{type:'application/pdf'}));const a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),30000)}
+export function DownloadFiles({envelope,onClose}){
+ const docs=envelope.documents||[],[chosen,setChosen]=useState(docs.map(d=>d.id)),[certificate,setCertificate]=useState(true),[combine,setCombine]=useState(false),[busy,setBusy]=useState(false),[error,setError]=useState('');
+ const modal=useRef(null);useEffect(()=>{modal.current.showModal()},[]);
+ const all=chosen.length===docs.length&&certificate;
+ function toggle(id){setChosen(x=>x.includes(id)?x.filter(v=>v!==id):[...x,id])}
+ async function download(){setBusy(true);setError('');try{
+  const selected=docs.filter(d=>chosen.includes(d.id)).map(d=>({name:d.name,url:d.fileUrl}));
+  if(certificate){if(!envelope.certificateUrl)throw new Error('The certificate is unavailable.');selected.push({name:'Certificate of Completion.pdf',url:envelope.certificateUrl})}
+  if(!selected.length)throw new Error('Select at least one file.');
+  if(combine){const merged=await PDFDocument.create();for(const item of selected){const source=await PDFDocument.load(bytes(item.url));for(const page of await merged.copyPages(source,source.getPageIndices()))merged.addPage(page)}save(envelope.subject+' - Combined.pdf',await merged.save())}
+  else for(const item of selected){save(item.name,bytes(item.url));await new Promise(r=>setTimeout(r,180))}
+  onClose();
+ }catch(e){setError(String(e.message||e));setBusy(false)}}
+ return <dialog ref={modal} aria-label="Download files" onCancel={e=>{e.preventDefault();onClose()}} style={{background:'white',width:600,maxHeight:'92vh',overflow:'auto',padding:28,color:'#343440',fontSize:15,boxShadow:'0 8px 30px #0003',margin:'auto'}}><style>{'dialog::backdrop{background:rgba(0,0,0,.4)}input[type=checkbox]{width:19px;height:19px;accent-color:#6594ff}'}</style>
+ <div style={{display:'flex',justifyContent:'space-between',alignItems:'center'}}><h2 style={{fontSize:24,fontWeight:600}}>Download files</h2><button aria-label="Close download files" onClick={onClose}><X size={22}/></button></div>
+ <p style={{margin:'18px 0 25px'}}>Select which files you want to download:</p>
+ <label style={row}><input type="checkbox" checked={all} onChange={e=>{setChosen(e.target.checked?docs.map(d=>d.id):[]);setCertificate(e.target.checked)}}/> All</label><small style={sub}>{docs.length+1} files</small>
+ <label style={row}><input type="checkbox" checked={chosen.length===docs.length} onChange={e=>setChosen(e.target.checked?docs.map(d=>d.id):[])}/> Document</label><small style={sub}>{docs.length} PDF{docs.length===1?'':'s'}</small>
+ {docs.length>1&&<div style={{marginLeft:30,marginBottom:12}}>{docs.map(d=><label key={d.id} style={{...row,fontSize:14,margin:'8px 0'}}><input type="checkbox" checked={chosen.includes(d.id)} onChange={()=>toggle(d.id)}/>{d.name}<small style={{color:'#73737a'}}>({d.order})</small></label>)}</div>}
+ <label style={row}><input type="checkbox" checked={certificate} onChange={e=>setCertificate(e.target.checked)}/> Certificate of Completion</label><small style={sub}>1 PDF</small>
+ <hr style={{margin:'28px 0'}}/><label style={row}><input type="checkbox" checked={combine} onChange={e=>setCombine(e.target.checked)}/> Combine all PDFs into a single file</label>
+ {error&&<p role="alert" style={{color:'#b00'}}>{error}</p>}<div style={{display:'flex',justifyContent:'flex-end',marginTop:35}}><button disabled={busy||(!certificate&&!chosen.length)} onClick={download} style={{background:'#006aff',color:'white',padding:'11px 22px',fontWeight:600}}>{busy?'Downloading…':'Download'}</button></div>
+ </dialog>
+}
+const row={display:'flex',gap:10,alignItems:'center',margin:'14px 0 4px',cursor:'pointer'};
+const sub={display:'block',margin:'0 0 14px 30px',color:'#777',fontSize:12};
+export function CompletedEnvelope({envelope}){
+ const navigate=useNavigate(),[open,setOpen]=useState(false),[tab,setTab]=useState('Recipients');
+ return <div style={{color:'#19142d',fontFamily:'Arial,sans-serif'}}>
+ <header style={{background:'#f7f6f8',padding:'28px 38px',borderBottom:'1px solid #eee'}}><span style={{background:'#ecebf0',padding:'6px 9px',fontSize:14}}>✓ Completed</span><div style={{display:'flex',justifyContent:'space-between',marginTop:18}}><h1 style={{fontSize:24,fontWeight:400}}>{envelope.subject}</h1><button aria-label="Download" onClick={()=>setOpen(true)} style={{border:'1px solid #aaa',padding:'10px 14px'}}><Download size={20}/><span>Download</span></button></div><p style={{marginTop:12}}>From: {envelope.senderName||'Morgan Ellis'} &nbsp; | &nbsp; <button onClick={()=>navigator.clipboard.writeText(envelope.id)} style={{textDecoration:'underline'}}>Envelope ID</button> &nbsp; {envelope.id}</p></header>
+ <div style={{display:'grid',gridTemplateColumns:'minmax(0,1fr) 300px',minHeight:520}}><section style={{padding:'35px 38px'}}><div style={{display:'flex',gap:26,borderBottom:'1px solid #ddd'}}>{['Recipients','Details'].map(t=><button key={t} onClick={()=>setTab(t)} style={{padding:'16px 8px',borderBottom:tab===t?'3px solid #28164c':'3px solid transparent'}}>{t}{t==='Recipients'?' ('+envelope.recipients.length+')':''}</button>)}</div>
+ {tab==='Recipients'?<><p style={{background:'#f5f4f7',display:'inline-block',padding:12,marginTop:28}}>Signing Order</p>{envelope.recipients.map(r=><div key={r.id} style={{padding:'30px 12px',borderBottom:'1px solid #ddd',display:'flex',justifyContent:'space-between'}}><div><p style={{fontSize:18}}>✓ &nbsp; {r.name}</p><small>{r.email}</small></div><div>Signed<br/><small>{r.signedAt}</small></div></div>)}</>:<><p style={{marginTop:24}}>{envelope.message}</p><h3 style={{marginTop:25}}>History</h3>{envelope.history.map(h=><p key={h.id} style={{marginTop:12}}>{h.timestamp} · {h.details}</p>)}</>}
+ </section><aside style={{borderLeft:'1px solid #ddd',padding:30}}><h2 style={{fontSize:14,marginBottom:24}}>Documents</h2>{envelope.documents.map(d=><button key={d.id} onClick={()=>navigate('/sign/'+envelope.id+'?document='+encodeURIComponent(d.id))} style={{display:'block',textAlign:'left',border:'1px solid #ddd',borderRadius:9,width:'100%',marginBottom:18,overflow:'hidden'}}><div style={{height:120,background:'#f1f0f4',display:'flex',alignItems:'center',justifyContent:'center'}}><iframe title={d.name+" thumbnail"} src={d.fileUrl+"#toolbar=0&navpanes=0&view=FitH"} style={{width:"200%",height:280,border:0,pointerEvents:"none",transform:"scale(.5)",transformOrigin:"top center"}}/></div><div style={{padding:14}}><p>{d.name}</p><small>{d.pageCount} page{d.pageCount===1?'':'s'}</small></div></button>)}</aside></div>
+ {open&&<DownloadFiles envelope={envelope} onClose={()=>setOpen(false)}/>}
+ </div>
+}
