+.disclosure-mark { padding: 6px 0; }
+.disclosure-mark mark { overflow-wrap: anywhere; white-space: pre-wrap; }
+.disclosure-file { display: inline-block; margin: 6px 8px 0 0; }
+.disclosure-utility { display: flex; gap: 8px; align-items: center; margin: 8px 0; }
+.disclosure-comment-actions { position: relative; margin-left: auto; }
+.disclosure-comment-actions [role="menu"] { position: absolute; top: 100%; right: 0; z-index: 1; background: white; width: max-content; padding: 4px; border: 1px solid #a9b9ce; border-radius: 5px; }
