diff --git a/src/pages/DisclosurePanel.jsx b/src/pages/DisclosurePanel.jsx
new file mode 100644
index 0000000..d1bd246
--- /dev/null
+++ b/src/pages/DisclosurePanel.jsx
@@ -0,0 +1,96 @@
+import React, { useEffect, useRef, useState } from 'react';
+import './DisclosurePanel.css';
+
+export function AttachmentList({ comment, onOpen }) {
+  return (comment.attachments || []).map(file => (
+    <button key={file.id} type="button" className="disclosure-file"
+      onClick={() => onOpen(file)}>{file.file_name}</button>
+  ));
+}
+
+export function DisclosureDialog({ title, children, onClose }) {
+  const ref = useRef(null);
+  useEffect(() => {
+    ref.current.showModal();
+  }, []);
+  return <dialog ref={ref} className="disclosure-dialog" aria-label={title}
+    onCancel={event => { event.preventDefault(); onClose(); }}>
+    <header><h2>{title}</h2><button type="button" onClick={onClose} aria-label="Close dialog">×</button></header>
+    {children}
+  </dialog>;
+}
+
+export function RedactionEditor({ comment, onApply }) {
+  const [ranges, setRanges] = useState([]);
+  const [files, setFiles] = useState([]);
+  const [notice, setNotice] = useState('');
+  const selection = useRef(null);
+
+  function markSelection() {
+    const { selectionStart: start, selectionEnd: end } = selection.current;
+    if (start === end) {
+      setNotice('Select a text range first.');
+      return;
+    }
+    if (ranges.some(range => start < range.end && end > range.start)) {
+      setNotice('This selection overlaps a marked range. Unmark the earlier selection first.');
+      return;
+    }
+    setRanges([...ranges, { start, end }]);
+    setNotice('');
+  }
+
+  function apply() {
+    const body = [...ranges].sort((left, right) => right.start - left.start).reduce(
+      (text, { start, end }) => text.slice(0, start) + '█'.repeat(end - start) + text.slice(end), comment.body);
+    const attachments = (comment.attachments || []).filter(file => !files.includes(file.id));
+    onApply({ body, html_body: '', attachments });
+  }
+
+  return <div>
+    <label htmlFor="redaction-source">Comment text</label>
+    <textarea id="redaction-source" ref={selection} readOnly wrap="off" rows={6} value={comment.body} />
+    <button type="button" onClick={markSelection}>Mark for redaction</button>
+    {notice && <p role="status">{notice}</p>}
+    {ranges.map(({ start, end }) => <div className="disclosure-mark" key={start}>
+      <mark>{comment.body.slice(start, end)}</mark>
+      <button type="button" onClick={() => setRanges(ranges.filter(range => range.start !== start))}>Unmark</button>
+    </div>)}
+    {(comment.attachments || []).length > 0 && <fieldset>
+      <legend>Attachments to redact</legend>
+      {comment.attachments.map(file => <label key={file.id}>
+        <input type="checkbox" checked={files.includes(file.id)}
+          onChange={event => setFiles(event.target.checked ? [...files, file.id] : files.filter(id => id !== file.id))} />
+        {file.file_name}
+      </label>)}
+    </fieldset>}
+    <footer>
+      <p>Redaction permanently removes the marked material from this ticket.</p>
+      <button type="button" className="disclosure-primary" onClick={apply} disabled={!ranges.length && !files.length}>Redact</button>
+    </footer>
+  </div>;
+}
+
+export function RequestView({ ticket, comments, requester, getUser, onOpen }) {
+  return <section className="disclosure-request">
+    <header><strong>Harborline Help Center</strong><span>{requester.name}</span></header>
+    <p>My activities / Requests / #{ticket.id}</p>
+    <h2>{ticket.subject}</h2>
+    <div className="disclosure-request-columns">
+      <div>
+        {comments.filter(comment => comment.public).map(comment => <article key={comment.id}>
+          <strong>{getUser(comment.author_id)?.name}</strong>
+          <time dateTime={comment.created_at}>{new Date(comment.created_at).toLocaleString()}</time>
+          <p>{comment.body}</p>
+          <AttachmentList comment={comment} onOpen={onOpen} />
+        </article>)}
+      </div>
+      <dl>
+        <dt>Requester</dt><dd>{requester.name}</dd>
+        <dt>Request ID</dt><dd>#{ticket.id}</dd>
+        <dt>Status</dt><dd>{ticket.status === 'pending' ? 'Awaiting your reply' : ticket.status}</dd>
+      </dl>
+    </div>
+  </section>;
+}
+
