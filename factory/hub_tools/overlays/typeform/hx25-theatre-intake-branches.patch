--- /dev/null
+++ b/src/pages/CookieConsent.jsx
@@ -0,0 +1,39 @@
+import { useState } from 'react'
+import { Ellipsis } from 'lucide-react'
+
+const optional = [
+  ['analytics', 'Analytical cookies'],
+  ['functional', 'Functional cookies'],
+  ['advertising', 'Advertising/profiling cookies'],
+]
+
+export default function CookieConsent({ formId }) {
+  const key = 'typeform:cookie-consent:' + formId
+  const [saved, setSaved] = useState(() => Boolean(localStorage.getItem(key)))
+  const [details, setDetails] = useState(false)
+  const [selection, setSelection] = useState({})
+  if (saved) return null
+
+  function save(preferences) {
+    localStorage.setItem(key, JSON.stringify(preferences))
+    setSaved(true)
+  }
+
+  const policy = <a href="https://www.typeform.com/legal/cookie-policy" target="_blank" rel="noreferrer">Cookie policy</a>
+  return <aside className="respondent-cookies" aria-label="Cookie consent">
+    {details ? <>
+      <p>Typeform uses cookies from its own services and third parties to learn how respondents find and use forms. {policy}</p>
+      <label><input type="checkbox" checked disabled /> Strictly necessary cookies</label>
+      {optional.map(([key, label]) => <label key={key}><input type="checkbox" checked={!!selection[key]}
+        onChange={(event) => setSelection({ ...selection, [key]: event.target.checked })} /> {label}</label>)}
+      <div className="cookie-actions"><button onClick={() => save(selection)}>Save selection</button></div>
+    </> : <>
+      <p>Typeform uses its own and third party cookies for analytical and profiling / advertising purposes. {policy}</p>
+      <div className="cookie-actions">
+        <button onClick={() => save(Object.fromEntries(optional.map(([key]) => [key, true])))}>Accept all</button>
+        <button onClick={() => save({})}>Reject all</button>
+        <button className="icon-button" aria-label="Cookie preferences" onClick={() => setDetails(true)}><Ellipsis size={18} /></button>
+      </div>
+    </>}
+  </aside>
+}
