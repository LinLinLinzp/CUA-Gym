+import React, {useState} from 'react';
+
+// Record attachments commit independently of incident field edits.
+export default function MaintenanceAttachments({form, managerOpen, onClose, onOpen, onAttachmentsChange, onBusy}) {
+  const [photo,setPhoto]=useState(null),[zoom,setZoom]=useState(1);
+  const [notice,setNotice]=useState(''),[busy,setBusy]=useState(false);
+  const [rows,setRows]=useState([[]]),[selected,setSelected]=useState([]),[reset,setReset]=useState(0);
+  const attachments=form.attachments||[];
+  const sid=new URLSearchParams(window.location.search).get('sid')||'';
+  const pending=v=>{setBusy(v);onBusy(v);};
+  const close=()=>{if(busy)return;setRows([[]]);setSelected([]);setReset(v=>v+1);setNotice('');onClose();};
+  const attach=async()=>{
+    const files=rows.flat();if(!files.length||busy)return;
+    pending(true);setNotice('Attaching files…');
+    try{
+      const body=new FormData();for(const file of files)body.append('files',file,file.name);
+      const response=await fetch('/upload?sid='+encodeURIComponent(sid),{method:'POST',body});
+      const result=await response.json();
+      if(!response.ok||!result.success||result.files?.length!==files.length)throw new Error(result.error||'File upload failed.');
+      const added=result.files.map(f=>({name:f.original_name,url:f.url,size:f.size,content_type:f.content_type,attached_at:new Date().toISOString()}));
+      await onAttachmentsChange(previous=>[...previous,...added]);
+      setRows([[]]);setReset(v=>v+1);setNotice('Files attached.');
+    }catch(error){setNotice('Unable to attach files: '+error.message);}finally{pending(false);}
+  };
+  const remove=async()=>{
+    if(busy||form.state===7||!selected.length)return;
+    pending(true);setNotice('Removing attachments…');
+    try{await onAttachmentsChange(previous=>previous.filter(a=>!selected.includes(a.url)));setSelected([]);setNotice('Attachments removed.');}
+    catch(error){setNotice('Unable to remove attachments: '+error.message);}finally{pending(false);}
+  };
+  return <>
+    {attachments.length>0&&<div className="sn-record-attachments"><button className="sn-attachment-link" onClick={onOpen}>Manage Attachments ({attachments.length})</button>{attachments.map(p=><a key={p.url} href={p.url} download={p.name}>{p.name}</a>)}</div>}
+    {managerOpen&&<div className="sn-attachment-backdrop"><section role="dialog" aria-modal="true" aria-labelledby="sn-attachment-title" className="sn-attachment-dialog">
+      <header><h2 id="sn-attachment-title">Attachments</h2><button className="sn-attachment-close" disabled={busy} aria-label="Close Attachments" onClick={close}>×</button></header>
+      <div className="sn-attachment-content">
+        <p>Attach files to {form.number}</p>
+        {rows.map((_,index)=><div key={reset+'-'+index} className="sn-choose-row"><input type="file" multiple disabled={busy} aria-label={index===0?'Choose Files':'Choose Files '+(index+1)} onChange={e=>setRows(previous=>previous.map((files,n)=>n===index?Array.from(e.target.files||[]):files))}/></div>)}
+        <div className="sn-attach-actions"><button className="sn-attachment-link" disabled={busy} onClick={()=>setRows(previous=>[...previous,[]])}>Add Another Attachment</button><button className="sn-btn" disabled={busy||!rows.flat().length} onClick={attach}>Attach</button></div>
+        <p role="status" className="sn-attachment-notice">{notice}</p>
+        <h3>Current file attachments</h3>
+        <div className="sn-current-attachments">{attachments.length?attachments.map(p=><div key={p.url} className="sn-current-attachment"><input type="checkbox" aria-label={'Select '+p.name} disabled={busy||form.state===7} checked={selected.includes(p.url)} onChange={e=>setSelected(previous=>e.target.checked?[...previous,p.url]:previous.filter(url=>url!==p.url))}/><a href={p.url} download={p.name}>{p.name}</a><span>{Math.ceil(p.size/1024)} KB</span><button className="sn-attachment-link" onClick={()=>{setPhoto(p);setZoom(1);}}>Preview {p.name}</button></div>):<p className="sn-empty-attachments">No attachments</p>}</div>
+        <button className="sn-btn" disabled={busy||form.state===7||!selected.length} onClick={remove}>Remove</button>
+        {form.state===7&&<p className="sn-attachment-notice">Attachments cannot be removed from a closed record.</p>}
+      </div><footer><button className="sn-btn" disabled={busy} onClick={close}>Close</button></footer>
+    </section></div>}
+    {photo&&<div role="dialog" aria-label="Original photo preview" className="sn-photo-preview"><div className="sn-photo-toolbar"><strong>{photo.name}</strong><button className="sn-btn" onClick={()=>setZoom(Math.max(.5,zoom-.5))}>Zoom −</button><button className="sn-btn" onClick={()=>setZoom(Math.min(5,zoom+.5))}>Zoom +</button><span>{Math.round(zoom*100)}%</span><a href={photo.url} download={photo.name}>Download original</a><button className="sn-btn" onClick={()=>setPhoto(null)}>Close preview</button></div><div className="sn-photo-stage"><img alt={photo.name} src={photo.url} style={{width:zoom*100+'%',maxWidth:'none'}}/></div></div>}
+  </>;
+}
