+function PdfPreview({ file }) {
+  const [preview, setPreview] = useState(null)
+  const [failed, setFailed] = useState(false)
+  useEffect(() => {
+    const request = new AbortController()
+    let objectUrl
+    fetch(file.contentUrl, { signal: request.signal }).then(response => {
+      if (!response.ok) throw new Error('PDF unavailable')
+      return response.blob()
+    }).then(data => {
+      if (request.signal.aborted) return
+      objectUrl = URL.createObjectURL(new Blob([data], { type: 'application/pdf' }))
+      setPreview(objectUrl)
+    }).catch(() => {
+      if (!request.signal.aborted) setFailed(true)
+    })
+    return () => {
+      request.abort()
+      if (objectUrl) URL.revokeObjectURL(objectUrl)
+    }
+  }, [file.contentUrl])
+  if (failed) return <p role="alert">Preview unavailable. Download the PDF to open it.</p>
+  if (!preview) return <p role="status">Loading PDF preview…</p>
+  return <iframe className="archive-pdf" title={`Preview of ${nameOf(file)}`} src={preview} />
+}
