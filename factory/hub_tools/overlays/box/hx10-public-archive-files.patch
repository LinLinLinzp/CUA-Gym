+
+:root {
+  --paper: #fff;
+  --line: #dce2ee;
+  --muted: #526079;
+  --action: #3854a2;
+  --hover: #273e7f;
+  --selected: #eaf0fc;
+  --display: "Segoe UI", system-ui, sans-serif;
+  --rail-width: 188px;
+  color: #1d2944;
+  background: #fff;
+}
+button:hover, tbody tr:hover, tbody tr:focus-within { background: #eff3fb; }
+.danger { color: white; background: #96392c; border-color: #96392c; }
+.archive-rail {
+  position: fixed;
+  z-index: 4;
+  inset: 0 auto 0 0;
+  width: var(--rail-width);
+  display: flex;
+  flex-direction: column;
+  gap: 30px;
+  background: #233966;
+  color: #f5f8ff;
+  padding: 24px 14px;
+}
+.archive-brand {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  color: inherit;
+  font-size: 17px;
+  font-weight: 700;
+  text-decoration: none;
+  padding: 0 7px;
+}
+.archive-nav { display: grid; gap: 5px; }
+.archive-nav a {
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  padding: 10px 12px;
+  border-radius: 7px;
+  color: #e3ebff;
+  text-decoration: none;
+}
+.archive-nav a:hover, .archive-nav a[aria-current] { background: #385081; color: #fff; }
+.archive-nav a[aria-current] { font-weight: 700; }
+.archive-header {
+  margin-left: var(--rail-width);
+  min-height: 64px;
+  padding: 12px 32px;
+  display: flex;
+  justify-content: space-between;
+  gap: 18px;
+  align-items: center;
+  border-bottom: 1px solid var(--line);
+}
+.archive-header .global-search {
+  background: #f0f3f9;
+  border-color: transparent;
+  border-radius: 7px;
+  width: min(550px, 75%);
+  margin: 0;
+}
+.archive-header .avatar { background: #e5effc; color: #2f487e; }
+#main { margin: 0 0 0 var(--rail-width); padding: 22px 32px 40px; }
+.page-heading { align-items: center; gap: 12px; }
+.page-heading h1 { font-size: 27px; font-weight: 680; }
+.page-heading p { margin-top: 5px; }
+.archive-file-list .toolbar { padding: 7px 0; }
+.archive-file-list table th { text-transform: uppercase; background: #fff; }
+.archive-file-list table td { height: 47px; }
+.archive-file-list .table-footer { background: #fff; border-top: 1px solid var(--line); }
+.archive-upload { position: relative; cursor: pointer; }
+.archive-upload input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
+.archive-upload:focus-within { outline: 2px solid #285c92; outline-offset: 3px; }
+.dialog-content > .dialog-form { padding: 0; gap: 10px; }
+.dialog-content > .dialog-form .field:has(select[name=role]) {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  color: var(--action);
+}
+.archive-invite-recipients { position: relative; }
+.archive-invite-recipients .suggestions {
+  position: absolute;
+  z-index: 2;
+  background: #fff;
+  width: 100%;
+  padding: 5px;
+  border: 1px solid var(--line);
+  box-shadow: 0 3px 12px #1d294422;
+}
+.archive-share-link {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  border-block: 1px solid var(--line);
+  padding: 12px 0;
+}
+.archive-share-link small { display: block; margin-top: 3px; }
+.archive-preview { min-width: 0; background: #eef1f7; }
+.archive-preview .document p { white-space: pre-line; }
+.archive-pdf { border: 0; display: block; width: 100%; height: 64vh; }
+@media (max-width: 740px) {
+  :root { --rail-width: 132px; }
+  .archive-rail { padding-inline: 6px; }
+  .archive-brand { font-size: 14px; }
+  .archive-header, #main { padding-inline: 14px; }
+}
